{% layout none %}
<title>
	{%if page_title == 'All'%}Tất cả sản phẩm{%else%}{{ page_title }}{%endif%}
	{% if current_tags %} tagged "{{ current_tags | join: ', ' }}"{% endif %}
	{% if current_page != 1 %} - Trang {{ current_page }}{% endif %}
	{% unless page_title contains store.name %} | {{ store.name }}{% endunless %}			
</title>		
<!-- ================= Page description ================== -->
{% if page_description != ""%}
<meta name="description" content="{{ page_description | escape }}">
{% endif %}
<!-- ================= Meta ================== -->
{%if template contains 'index'%}{%if settings.home_page_keywords != '' and settings.home_page_keywords != null%}<meta name="keywords" content="{{settings.home_page_keywords}}"/>{%else%}<meta name="keywords" content="{{store.name}}, {{store.domain}}"/>{%endif%}{%elsif template contains 'product'%}<meta name="keywords" content="{{product.name}}, {%for collection in product.collections%}{{collection.name}}, {%endfor%}{%if product.tags.size > 0%}{% for tag in product.tags %}{{tag}}, {%endfor%}{%endif%}{{store.name}}, {{store.domain}}"/>{%elsif template contains 'collection'%}<meta name="keywords" content="{{collection.name }}, {{store.name}}, {{store.domain}}"/>{%elsif template contains 'blog'%}<meta name="keywords" content="{{blog.name }}, {{store.name}}, {{store.domain}}"/>{%elsif template contains 'article'%}<meta name="keywords" content="{{article.title}}, {{blog.name}}, {%if article.tags.size > 0%}{% for tag in article.tags %}{{tag}}, {%endfor%}{%endif%} {{store.name}}, {{store.domain}}"/>{%else%}<meta name="keywords" content="{{page_title}}, {{store.name}}, {{store.domain}}"/>{%endif%}		
<link rel="canonical" href="{{ canonical_url }}"/>
<meta name='revisit-after' content='1 days' />
<meta name="robots" content="noodp,index,follow" />
<!-- ================= Favicon ================== -->
<link rel="icon" href="{{ 'favicon.png' | asset_url }}" type="image/x-icon" />
<link href="https://bizweb.dktcdn.net/100/183/481/themes/240176/assets/ec_documenter_style.css" media="all" rel="stylesheet" />
<link href="favicon.ico" rel="shortcut icon" type="image/x-icon" />
<script src="https://bizweb.dktcdn.net/100/183/481/themes/240176/assets/jquery.js"></script>
<script src="https://bizweb.dktcdn.net/100/183/481/themes/240176/assets/jquery.scrollto.js"></script>
<script src="https://bizweb.dktcdn.net/100/183/481/themes/240176/assets/jquery.easing.js"></script>
<script>document.createElement('section');var duration='290',easing='swing';</script>
<script src="https://bizweb.dktcdn.net/100/183/481/themes/240176/assets/ec_script.js"></script>
<style type="text/css">html{background-color:#F1F1F1;color:#383838;}
	::-moz-selection{background:#F94E3F;color:#FFFFFF;}
	::selection{background:#F94E3F;color:#FFFFFF;}
	#documenter_sidebar #documenter_logo{background-image:url(https://bizweb.dktcdn.net/100/183/481/files/ec-image-34.png);}
	a{color:#F94E3F;}
	.btn {
		border-radius:3px;
	}
	.btn-primary {
		background-image: -moz-linear-gradient(top, #F94E3F, #F94E3F);
		background-image: -ms-linear-gradient(top, #F94E3F, #F94E3F);
		background-image: -webkit-gradient(linear, 0 0, 0 F94E3F%, from(#333333), to(#F94E3F));
		background-image: -webkit-linear-gradient(top, #F94E3F, #F94E3F);
		background-image: -o-linear-gradient(top, #F94E3F, #F94E3F);
		background-image: linear-gradient(top, #F94E3F, #F94E3F);
		filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#F94E3F', endColorstr='#F94E3F', GradientType=0);
		border-color: #F94E3F #F94E3F #bfbfbf;
		color:#FFFFFF;
	}
	.btn-primary:hover,
	.btn-primary:active,
	.btn-primary.active,
	.btn-primary.disabled,
	.btn-primary[disabled] {
		border-color: #F94E3F #F94E3F #bfbfbf;
		background-color: #F94E3F;
	}
	hr{border-top:1px solid #EBEBEB;border-bottom:1px solid #FFFFFF;}
	#documenter_sidebar, #documenter_sidebar ul a{background-color:#333333;color:#FFFFFF;}
	#documenter_sidebar ul a{-webkit-text-shadow:1px 1px 0px #333333;-moz-text-shadow:1px 1px 0px #333333;text-shadow:1px 1px 0px #333333;}
	#documenter_sidebar ul{border-top:1px solid #E1E1E1;}
	#documenter_sidebar ul a{border-top:1px solid #333333;border-bottom:1px solid #E1E1E1;color:#FFFFFF;}
	#documenter_sidebar ul a:hover{background:#F94E3F;color:#FFFFFF;border-top:1px solid #F94E3F;}
	#documenter_sidebar ul a.current{background:#F94E3F;color:#FFFFFF;border-top:1px solid #F94E3F;}
	#documenter_copyright{display:block !important;visibility:visible !important;}
	#admin_bar_iframe{display:none;}
	#documenter_content img{max-width:100% !important;height:auto !important;width:auto !important;}
</style>
