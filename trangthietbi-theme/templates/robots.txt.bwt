# we use Sapo as our ecommerce platform
{% for group in robots.default_groups %}
  {{- group.user_agent -}}
  {% for rule in group.rules %}
    {{- rule -}}
  {%- endfor -%}
  {% if group.sitemap != blank %}
    {{- group.sitemap -}}
  {% endif %}
{% endfor %}

Disallow: /*?fbclid=
Disallow: /*?view=
Disallow: /*?q=
