<script src='{{ 'showroom.js' | asset_url }}' type='text/javascript'></script>
<script src='{{ 'jquery-gmaps-latlon-picker.js' | asset_url }}' type='text/javascript'></script>
<script src="//maps.googleapis.com/maps/api/js?sensor=false"></script>
{% include 'breadcrumb' %}
<section class="page">
	<div class="container">
		<div class="row">
			<div class="col-xs-12 col-sm-12 col-md-12">
				<div class="page-title category-title">
					<h1 class="title-head"><a href="#">{{ page_title }}</a></h1>
				</div>
				<div class="content-page rte">
					<div class="ct_content_wrap page-mains">
						<section class="ct_blog_outer_wrap">
							<div class="row system-center">
								<div class="post col-md-3 col-sm-4">
									<div class="showroom-list">
										<div class="city-selector">
											<h2 class="title">Chọn tỉnh thành</h2>
											<select name="showroom_city_id" class="showroom_city_id">
												<option label="{{ settings.city_name }}" value="1">{{ settings.city_name }}</option>
												{% if settings.city_name_2.size > 0 %}
												<option label="{{ settings.city_name_2 }}" value="2">{{ settings.city_name_2 }}</option>
												{% endif %}
												{% if settings.city_name_3.size > 0 %}
												<option label="{{ settings.city_name_3 }}" value="3">{{ settings.city_name_3 }}</option>
												{% endif %}
												{% if settings.city_name_4.size > 0 %}
												<option label="{{ settings.city_name_4 }}" value="4">{{ settings.city_name_4 }}</option>
												{% endif %}
											</select>
										</div>
										<div class="city_1 city-wrapper" style="display: block;">
											<div class="nano has-scrollbar">
												<div class="content">
													{% if settings.brand_name_enable_1 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_1 }}" lon="{{ settings.brand_long_1 }}">
														<h2 class="title">{{ settings.brand_name_1 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_1 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_1 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_2 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_2 }}" lon="{{ settings.brand_long_2 }}">
														<h2 class="title">{{ settings.brand_name_2 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_2 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_2 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_3 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_3 }}" lon="{{ settings.brand_long_3 }}">
														<h2 class="title">{{ settings.brand_name_3 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_3 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_3 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_4 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_4 }}" lon="{{ settings.brand_long_4 }}">
														<h2 class="title">{{ settings.brand_name_4 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_4 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_4 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_5 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_5 }}" lon="{{ settings.brand_long_5 }}">
														<h2 class="title">{{ settings.brand_name_5 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_5 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_5 }}</p>
													</div>
													{% endif %}
												</div>
											</div>
										</div>
										<div class="city_2 city-wrapper" style="display: none;">
											<div class="nano has-scrollbar">
												<div class="content" tabindex="0">
													{% if settings.brand_name_enable_1_2 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_1_2 }}" lon="{{ settings.brand_long_1_2 }}">
														<h2 class="title">{{ settings.brand_name_1_2 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_1_2 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_1_2 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_2_2 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_2_2 }}" lon="{{ settings.brand_long_2_2 }}">
														<h2 class="title">{{ settings.brand_name_2_2 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_2_2 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_2_2 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_3_2 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_3_2 }}" lon="{{ settings.brand_long_3_2 }}">
														<h2 class="title">{{ settings.brand_name_3_2 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_3_2 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_3_2 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_4_2 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_4_2 }}" lon="{{ settings.brand_long_4_2 }}">
														<h2 class="title">{{ settings.brand_name_4_2 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_4_2 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_4_2 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_5_2 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_5_2 }}" lon="{{ settings.brand_long_5_2 }}">
														<h2 class="title">{{ settings.brand_name_5_2 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_5_2 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_5_2 }}</p>
													</div>
													{% endif %}
												</div>
											</div>
										</div>
										<div class="city_3 city-wrapper">
											<div class="nano has-scrollbar">
												<div class="content" tabindex="0" style="right: -17px;">
													{% if settings.brand_name_enable_1_3 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_1_3 }}" lon="{{ settings.brand_long_1_3 }}">
														<h2 class="title">{{ settings.brand_name_1_3 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_1_3 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_1_3 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_2_3 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_2_3 }}" lon="{{ settings.brand_long_2_3 }}">
														<h2 class="title">{{ settings.brand_name_2_3 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_2_3 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_2_3 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_3_3 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_3_3 }}" lon="{{ settings.brand_long_3_3 }}">
														<h2 class="title">{{ settings.brand_name_3_3 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_3_3 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_3_3 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_4_3 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_4_3 }}" lon="{{ settings.brand_long_4_3 }}">
														<h2 class="title">{{ settings.brand_name_4_3 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_4_3 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_4_3 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_5_3 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_5_3 }}" lon="{{ settings.brand_long_5_3 }}">
														<h2 class="title">{{ settings.brand_name_5_3 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_5_3 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_5_3 }}</p>
													</div>
													{% endif %}
												</div>
											</div>
										</div>
										<div class="city_4 city-wrapper" style="display: none;">
											<div class="nano has-scrollbar">
												<div class="content" tabindex="0">
													{% if settings.brand_name_enable_1_4 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_1_4 }}" lon="{{ settings.brand_long_1_4 }}">
														<h2 class="title">{{ settings.brand_name_1_4 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_1_4 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_1_4 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_2_4 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_2_4 }}" lon="{{ settings.brand_long_2_4 }}">
														<h2 class="title">{{ settings.brand_name_2_4 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_2_4 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_2_4 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_3_4 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_3_4 }}" lon="{{ settings.brand_long_3_4 }}">
														<h2 class="title">{{ settings.brand_name_3_4 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_3_4 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_3_4 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_4_4 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_4_4 }}" lon="{{ settings.brand_long_4_4 }}">
														<h2 class="title">{{ settings.brand_name_4_4 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_4_4 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_4_4 }}</p>
													</div>
													{% endif %}
													{% if settings.brand_name_enable_5_4 %}
													<div class="showroom-item" lat="{{ settings.brand_lat_5_4 }}" lon="{{ settings.brand_long_5_4 }}">
														<h2 class="title">{{ settings.brand_name_5_4 }}</h2>
														<p class="showroom-address"><i class="fa fa-map-marker"></i> {{ settings.brand_address_5_4 }}</p>
														<p class="showroom-contact"><i class="fa fa-phone"></i> {{ settings.brand_phone_5_4 }}</p>
													</div>
													{% endif %}
												</div>

											</div>
										</div>
									</div>
								</div>
								<div class="col-md-9 col-sm-8">
									<fieldset class="gllpLatlonPicker" id="_MAP_5158">
										<div class="gllpMap"></div>
										<input type="hidden" class="gllpLatitude" value="{{ settings.brand_lat_1 }}" name="showroom_lat">
										<input type="hidden" class="gllpLongitude" value="{{ settings.brand_long_1 }}" name="showroom_lon">
										<input type="button" class="gllpUpdateButton" value="update map">
										<input type="hidden" class="gllpZoom" value="17">
									</fieldset>
								</div>
							</div>
						</section>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
