{% include 'breadcrumb' %} 
<section class="address panel-login account-page mr-bottom-20">
	<div class="container">
		<div class="row">
			<div class="col-xs-12 col-lg-12">
				<h1 class="title-head" style="margin-top:0;">Địa chỉ của bạn</h1>
			</div>
			<div class="col-sm-12 col-lg-12">
				<div class="row">
					<div class="col-md-12">
						<p class="btn-row">
							<button class="btn-edit-addr btn btn-blues" type="button" onclick="Bizweb.CustomerAddress.toggleNewForm(); return false;" >+ Thêm địa chỉ</button> 							
						</p>
					</div>
					<div id="add_address" class="col-md-12 form-list" style="display:none; margin-top:30px;">
						{% form 'customer_address', customer.new_address %}
						<div class="clearfix row">
							<div class="col-xs-12 col-lg-12">
								<div class="form-group">
									<label>Tên<span class="required">*</span></label>
									<input type="text" data-validation-error-msg= "Không được để trống" data-validation="required" class="form-control" name="FirstName" placeholder="Nhập tên của bạn" value="{{customer.first_name}}" required requiredmsg="Không được bỏ trống">
								</div>
							</div>
							<div class="col-xs-12 col-lg-12">
								<div class="form-group">
									<label>Họ<span class="required">*</span></label>
									<input type="text" data-validation-error-msg= "Không được để trống" data-validation="required" class="form-control" name="LastName" placeholder="Nhập họ của bạn" value="{{customer.last_name}}" required requiredmsg="Không được bỏ trống">
								</div>
							</div>
							<div class="col-xs-12 col-lg-12">
								<div class="form-group">
									<label>Công ty</label>
									<input type="text" class="form-control" name="Company" placeholder="Nhập công ty của bạn" value="{{form.company}}" >
								</div>
							</div>
							<div class="col-xs-12 col-lg-12">
								<div class="form-group">
									<label>Địa chỉ<span class="required">*</span></label>
									<input type="text" data-validation-error-msg= "Không được để trống" data-validation="required" class="form-control" name="Address1" placeholder="Nhập địa chỉ của bạn" value="{{form.address1}}" required requiredmsg="Không được bỏ trống">
								</div>
							</div>
							<div class="col-xs-12 col-lg-12">
								<div class="form-group">
									<label>Địa chỉ 2</label>
									<input type="text" class="form-control" name="Address2"  placeholder="Nhập địa chỉ của bạn" value="{{form.address2}}" >
								</div>
							</div>
							<div class="col-xs-12 col-lg-12">
								<div class="form-group">
									<label>Thành phố<span class="required">*</span></label>
									<input type="text" data-validation-error-msg= "Không được để trống" data-validation="required" class="form-control" name="City"  placeholder="Nhập thành phố của bạn" value="{{form.city}}" required requiredmsg="Không được bỏ trống">
								</div>
							</div>
							<div class="col-xs-12 col-lg-12">
								<div class="form-group">
									<label>Quốc gia<span class="required">*</span></label>
									<select name="Country" class="form-control mySelect2" id="mySelect1" data-default="Việt Nam" >{{ country_option_tags }}</select>
								</div>
							</div>
							<div class="col-xs-12 col-lg-12">
								<div class="form-group">
									<label>Mã Zip</label>
									<input type="text" class="form-control" name="Zip"  placeholder="Nhập địa chỉ của bạn" value="{{form.zip}}" >
								</div>
							</div>
							<div class="col-xs-12 col-lg-12">
								<div class="form-group" style="margin-bottom:0;">
									<label>Số điện thoại<span class="required">*</span></label>
									<input type="text" data-validation-error-msg= "Không được để trống" data-validation="required" class="form-control number-sidebar" name="PhoneNumber" placeholder="Nhập số điện thoại của bạn" value="{{form.phone}}" required requiredmsg="Không được bỏ trống">
								</div>
							</div>

							<div class="checkbox col-xs-12 col-lg-12">
								<label class="c-input c-checkbox">
									<input type="checkbox" id="address_default_address_{{form.id}}" name="IsDefault" value="true" style="top:5px;" />
									<span class="c-indicator"></span> 
									Đặt là địa chỉ mặc định?
								</label>
							</div>
							<div class="form-group clearfix col-xs-12">
								<div class="col-sm-12">
									<div class="rows">										
										<button class="btn btn-blues" type="submit"><span><i class="fa fa-check"></i> Thêm địa chỉ</span></button>
										<button class="btn btn-blues article-readmore" type="button" onclick="Bizweb.CustomerAddress.toggleNewForm(); return false;"><span><i class="fa fa-close"></i> Hủy</span></button>									
									</div>
								</div>
							</div>
						</div>
						{% endform %}
					</div>
				</div>
			</div>
			<div class="col-sm-12 col-lg-12">
				<div class="row total_address collections-container">
					{% paginate customer.addresses by 5 %}
					{% for address in customer.addresses %}      
					<div id="view_address_{{address.id}}" class="customer_address col-xs-12">
						<div class="row" style="border-top: 1px #ebebeb solid;padding-top: 30px;margin-top: 30px;">
							<div class="col-sm-6">
								<div class="address_info ">
									<div class="info clearfix">
										<span class="address-group">
											<div class="address form-signup">
												<p><strong>Tên tài khoản: </strong>{{address.last_name }} {{ address.first_name }}
													{% if address.id == customer.default_address.id %}
													<small>(Địa chỉ mặc định)</small>
													{% endif %}
												</p>
												{% if address.company.size > 0 %}
												<p><strong>Công ty:</strong> {{ address.company }}</p>
												{% endif %}
												<p>
													<strong>Địa chỉ: </strong> {{ address.address1 }}{% if address.address2 != null %}, {{ address.address2 }}{% endif %}{% if address.district != null %}, {{ address.district}}{% endif %}{% if address.city != null %}, {{ address.city}}{% endif %}{% if address.country != null %}, {{ address.country }}{% endif %}
												</p>
												<p><strong>Quốc tịch:</strong> {{ address.country }}</p>
												<p><strong>Số điện thoại:</strong> <a href="tel:{{ address.phone }}" title="{{ address.phone }}">{{ address.phone }}</a></p>
											</div>
										</span>
									</div>
								</div>
								<div id="tool_address_{{address.id}}" class="">
									<p class="btn-row">
										<button class="btn-edit-addr btn btn-blues" type="button" data-toggle="collapse" data-target="#collapseExample-{{address.id}}" aria-expanded="false" aria-controls="collapseExample-{{address.id}}">
											<i class="fa fa-undo"></i> Chỉnh sửa địa chỉ
										</button>
										<button class="{% if address.id == customer.default_address.id %}hidden {% endif %}btn btn-blues btn-edit-addr" type="button" onclick="Bizweb.CustomerAddress.destroy({{address.id}});return false"><span><i class="fa fa-close"></i> Xóa</span></button>
									</p>
								</div>
							</div>
							<div class="col-sm-6">
								<div class="collapse" id="collapseExample-{{address.id}}" style="display: none;">
									<div id="edit_address_{{address.id}}" class="form-list">
										{% form 'customer_address', address %}
										<div class="clearfix">
											<div class="form-group">
												<label>Tên<span class="required">*</span></label>
												<input type="text" class="form-control" data-validation-error-msg= "Không được để trống" data-validation="required" name="FirstName" value="{{form.first_name}}" required requiredmsg="Không được bỏ trống">
											</div>
											<div class="form-group">
												<label>Họ<span class="required">*</span></label>
												<input type="text" class="form-control" data-validation-error-msg= "Không được để trống" data-validation="required" name="LastName" value="{{form.last_name}}" required requiredmsg="Không được bỏ trống">
											</div>
											<div class="form-group">
												<label>Công ty</label>
												<input type="text" class="form-control" name="Company" value="{{form.company}}" >
											</div>
											<div class="form-group">
												<label>Địa chỉ<span class="required">*</span></label>
												<input type="text" class="form-control" data-validation-error-msg= "Không được để trống" data-validation="required" name="Address1" value="{{form.address1}}" required requiredmsg="Không được bỏ trống">
											</div>
											<div class="form-group">
												<label>Địa chỉ 2</label>
												<input type="text" class="form-control" name="Address2" value="{{form.address2}}" >
											</div>
											<div class="form-group">
												<label>Thành phố<span class="required">*</span></label>
												<input type="text" class="form-control" data-validation-error-msg= "Không được để trống" data-validation="required" name="City" value="{{form.city}}" required requiredmsg="Không được bỏ trống">
											</div>
											<div class="form-group">
												<label>Quốc gia<span class="required">*</span></label>
												<select name="Country" class="form-control mySelect2" id="mySelect2_{{address.id}}" data-default="{{form.country}}" >{{form.country}}{{ country_option_tags }}</select>
											</div>
											<div class="form-group">
												<label>Mã Zip</label>
												<input type="text" class="form-control" name="Zip" value="{{form.zip}}" >
											</div>
											<div class="form-group">
												<label>Số điện thoại<span class="required">*</span></label>
												<input type="text" class="form-control number-sidebar" data-validation-error-msg= "Không được để trống" data-validation="required" name="PhoneNumber" value="{{form.phone}}" required requiredmsg="Không được bỏ trống">
											</div>
											{% if address.id == customer.default_address.id %}

											{% else %}
											<div class="checkbox">
												<label class="c-input c-checkbox">
													<input type="checkbox" id="address_default_address_{{form.id}}" name="IsDefault" value="true" style="top:4px;" />
													<span class="c-indicator"></span> 
													Đặt là địa chỉ mặc định?
												</label>
											</div>	
											{% endif %}
										</div>
										<div class="form-group clearfix">											
											<div class="col-sm-12">
												<div class="row">
													<button class="btn btn-blues" type="submit"><span><i class="fa fa-check-square-o"></i> Cập nhật địa chỉ</span></button>																	
													<button id="btn-{{address.id}}" class="btn btn-blues" type="button" data-toggle="collapse" data-target="#collapseExample-{{address.id}}" aria-expanded="false" aria-controls="collapseExample-{{address.id}}">
														<i class="fa fa-close"></i> Hủy
													</button>
												</div>
											</div>
										</div>
										{% endform %}
									</div>
									<script>
										$(document).ready(function() {
											$('#btn-{{address.id}}').click(function() {
												$('#collapseExample-{{address.id}}').css({
													'display': 'none'
												});
											});
										});
									</script>
								</div>
							</div>
						</div>
					</div>
					{% endfor %} 
					{% if paginate.pages > 1 %}
					<div class="col-xs-12">
						<div class="text-xs-right text-center pagging-css">
							{% include 'paginate-pages' %}
						</div>
					</div>
					{% endif %}
					{% endpaginate %}
				</div> 
			</div>
			<div class="col-sm-12 col-lg-12">
				<div class="text-centers" style="margin-top:0px;">
					<a href="/account" class="btn btn-blues"><i class="fa fa-reply" aria-hidden="true"></i> Trang thông tin tài khoản</a>
				</div>
			</div>
		</div>
	</div>
</section>



<script type="text/javascript" charset="utf-8">
	new Bizweb.CountrySelector('address_country_new');
	{% for address in customer.addresses %}
	new Bizweb.CountrySelector('address_country_{{address.id}}');
	 {% endfor %}

	 $(document).ready(function() {

		 var elements = $("input, select, textarea");
		 for (var i = 0; i < elements.length; i++) {
			 elements[i].oninvalid = function(e) {
				 e.target.setCustomValidity("");
				 if (!e.target.validity.valid) {
					 e.target.setCustomValidity(e.target.getAttribute("requiredmsg"));
				 }
			 };
			 elements[i].oninput = function(e) {
				 e.target.setCustomValidity("");
			 };
		 }
		 $('.btn-edit-addr').click(function(){
			 var ctr = $(this).attr('aria-controls');			
			 $('#'+ctr).slideToggle("fast");
		 });
		 $('.mySelect2').each(function(){
			 var old = $(this).attr('data-default');			  
			 $(this).val(old);
			 $(this).change();
		 })

	 })
</script>
