{% include 'breadcrumb' %}
<section>
	<div class="container mr-bottom-20">
		<div id="customer-reset-password">
			<div class="row">
				<div class="span12">
					<h1 class="title-head text-center">Lấy lại mật khẩu</h1>
					<div class="form-signup clearfix">
						<div class="row">
							<div class="col-md-6 col-md-offset-3">
								{% form 'reset_customer_password' %}
								{{ form.errors | default_errors }}
								<div class="row">
									<div class="col-md-12">
										<fieldset class="form-group">
											<label>Mật khẩu mới</label>
											<input type="password" class="form-control form-control-lg" value="" name="Password" id="customer_password"  required data-validation-error-msg= "Không được để trống" data-validation="required" >
										</fieldset>
									</div>
									<div class="col-md-12">
										<fieldset class="form-group">
											<label>Xác nhận mật khẩu</label>
											<input type="password" class="form-control form-control-lg" value="" name="ConfirmPassword" id="customer_password_confirmation"  required data-validation-error-msg= "Không được để trống" data-validation="required" >
										</fieldset>
									</div>
								</div>
								<div class="col-xs-12 text-center" style="margin-top:15px; padding: 0">
									<button type="summit" value="Đăng ký" class="btn btn-style btn-blues">Đặt lại mật khẩu</button>
								</div>
								{% endform %}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
