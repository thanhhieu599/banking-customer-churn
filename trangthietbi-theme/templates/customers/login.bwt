{% include 'breadcrumb' %}
<div class="container mr-bottom-20">
	<div class="auth-wrap">
		<div class="auth-card">

			<!-- ===== ĐĂNG NHẬP ===== -->
			<div id="login" class="auth-panel">
				<h1 class="auth-title">{{ page_title }}</h1>
				<p class="auth-sub">Chào mừng bạn quay lại. Đăng nhập để theo dõi đơn hàng và nhận báo giá nhanh hơn.</p>

				<div class="auth-social">
					<div class="auth-social-native">
						{{ social_login.script }}
						<div class="native-facebook">{{ social_login.facebook_button }}</div>
						<div class="native-google">{{ social_login.google_button }}</div>
					</div>

					<button type="button" class="auth-social-btn" data-provider="facebook">
						<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="#1877F2" d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.97.93-1.97 1.89v2.26h3.34l-.53 3.49h-2.8V24C19.62 23.1 24 18.1 24 12.07z"/></svg>
						<span>Facebook</span>
					</button>

					<button type="button" class="auth-social-btn" data-provider="google">
						<svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
						<span>Google</span>
					</button>
				</div>
				<div class="auth-divider"><span>hoặc dùng email</span></div>

				{% form 'customer_login' %}
					{% if form.errors %}
					<div class="auth-alert auth-alert-error">
						{% for field in form.errors %}
						{{ form.errors.messages[field] }}<br/>
						{% endfor %}
					</div>
					{% endif %}

					<div class="auth-field">
						<label for="customer_email">Email</label>
						<input type="email" class="form-control" name="email" id="customer_email" value="" placeholder="ten@congty.com" required data-validation="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$" data-validation-error-msg="Email sai định dạng" />
					</div>

					<div class="auth-field">
						<div class="auth-label-row">
							<label for="customer_password">Mật khẩu</label>
							<a href="#recover" class="auth-link" onclick="showRecoverPasswordForm();return false;">Quên mật khẩu?</a>
						</div>
						<div class="auth-pass">
							<input type="password" class="form-control" name="password" id="customer_password" value="" placeholder="Nhập mật khẩu" data-validation="required" data-validation-error-msg="Không được để trống" />
							<button type="button" class="auth-pass-toggle" aria-label="Hiện/ẩn mật khẩu">Hiện</button>
						</div>
					</div>

					<button type="submit" class="auth-btn">Đăng nhập</button>
				{% endform %}

				<p class="auth-foot">Chưa có tài khoản? <a href="/account/register" title="Đăng ký" class="auth-link">Đăng ký ngay</a></p>
			</div>

			<!-- ===== QUÊN MẬT KHẨU ===== -->
			<div id="recover-password" class="auth-panel" style="display:none;">
				<h1 class="auth-title">Quên mật khẩu</h1>
				<p class="auth-sub">Nhập email đã đăng ký, chúng tôi sẽ gửi hướng dẫn đặt lại mật khẩu cho bạn.</p>

				{% form 'recover_customer_password' %}
					{% if form.errors %}
					<div class="auth-alert auth-alert-error">
						{% for field in form.errors %}
						{{ form.errors.messages[field] }}<br/>
						{% endfor %}
					</div>
					{% endif %}

					{% if form.posted_successfully %}
					<div class="auth-alert auth-alert-success" role="alert">
						Email thiết lập lại mật khẩu đã được gửi. Vui lòng kiểm tra hộp thư và làm theo hướng dẫn.
					</div>
					{% endif %}

					<div class="auth-field">
						<label for="recover-email">Email</label>
						<input type="email" class="form-control" name="Email" id="recover-email" value="" placeholder="ten@congty.com" data-validation="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$" data-validation-error-msg="Email sai định dạng" />
					</div>

					<button type="submit" class="auth-btn">Lấy lại mật khẩu</button>
				{% endform %}

				<p class="auth-foot"><a href="#login" class="auth-link" onclick="hideRecoverPasswordForm();return false;">&larr; Quay lại đăng nhập</a></p>
			</div>

		</div>
	</div>
</div>

<style>
.auth-wrap { padding: 20px 0 40px; }
.auth-card {
	max-width: 460px;
	margin: 0 auto;
	padding: 36px 34px 30px;
	background: #fff;
	border: 1px solid #eee;
	border-radius: 14px;
	box-shadow: 0 10px 35px rgba(0, 0, 0, .07);
}
.auth-title {
	margin: 0 0 8px;
	font-size: 26px;
	font-weight: 700;
	line-height: 1.25;
	color: #222;
	text-align: center;
}
.auth-sub {
	margin: 0 0 22px;
	font-size: 14px;
	line-height: 1.5;
	color: #777;
	text-align: center;
}

/* Đăng nhập mạng xã hội */
.auth-social { display: flex; gap: 12px; }
.auth-social-native {
	position: absolute;
	width: 1px; height: 1px;
	overflow: hidden;
	clip: rect(0 0 0 0);
	white-space: nowrap;
}
.auth-social-btn {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 10px;
	height: 46px;
	border: 1px solid #dcdcdc;
	border-radius: 8px;
	background: #fff;
	font-size: 14px;
	font-weight: 600;
	color: #333;
	cursor: pointer;
	transition: border-color .2s, box-shadow .2s, background .2s;
}
.auth-social-btn:hover {
	border-color: #bbb;
	background: #fafafa;
	box-shadow: 0 2px 8px rgba(0, 0, 0, .08);
}
@media (max-width: 380px) {
	.auth-social { flex-direction: column; }
}
.auth-divider {
	position: relative;
	margin: 18px 0 20px;
	text-align: center;
}
.auth-divider:before {
	content: "";
	position: absolute;
	left: 0; right: 0; top: 50%;
	border-top: 1px solid #e6e6e6;
}
.auth-divider span {
	position: relative;
	padding: 0 12px;
	background: #fff;
	font-size: 12px;
	color: #999;
}

/* Trường nhập */
.auth-field { margin-bottom: 16px; }
.auth-field label {
	display: block;
	margin-bottom: 6px;
	font-size: 13px;
	font-weight: 600;
	color: #333;
}
.auth-label-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
}
.auth-card .form-control {
	width: 100%;
	height: 46px;
	padding: 0 14px;
	border: 1px solid #dcdcdc;
	border-radius: 8px;
	background: #fafafa;
	font-size: 14px;
	box-shadow: none;
	transition: border-color .2s, background .2s, box-shadow .2s;
}
.auth-card .form-control:focus {
	border-color: #bf2026;
	background: #fff;
	box-shadow: 0 0 0 3px rgba(191, 32, 38, .12);
	outline: none;
}
.auth-pass { position: relative; }
.auth-pass .form-control { padding-right: 64px; }
.auth-pass-toggle {
	position: absolute;
	top: 0; right: 0;
	height: 46px;
	padding: 0 14px;
	border: 0;
	background: transparent;
	font-size: 12px;
	font-weight: 600;
	color: #888;
	cursor: pointer;
}
.auth-pass-toggle:hover { color: #bf2026; }

/* Nút và liên kết */
.auth-btn {
	display: block;
	width: 100%;
	height: 48px;
	margin-top: 22px;
	border: 0;
	border-radius: 8px;
	background: #bf2026;
	color: #fff;
	font-size: 15px;
	font-weight: 700;
	cursor: pointer;
	transition: background .2s, transform .1s;
}
.auth-btn:hover { background: #a01a20; }
.auth-btn:active { transform: translateY(1px); }
.auth-link { color: #bf2026; font-weight: 600; text-decoration: none; }
.auth-link:hover { text-decoration: underline; color: #a01a20; }
.auth-foot {
	margin: 22px 0 0;
	font-size: 14px;
	color: #666;
	text-align: center;
}

/* Thông báo */
.auth-alert {
	margin-bottom: 16px;
	padding: 11px 14px;
	border-radius: 8px;
	font-size: 13px;
	line-height: 1.5;
}
.auth-alert-error { background: #fdecec; color: #b42318; border: 1px solid #f7c9c9; }
.auth-alert-success { background: #e8f6ee; color: #1b6b3a; border: 1px solid #bfe3cd; }

@media (max-width: 480px) {
	.auth-card { padding: 26px 20px 22px; border-radius: 10px; box-shadow: none; }
	.auth-title { font-size: 22px; }
}
</style>

<script type="text/javascript">
	function showRecoverPasswordForm() {
		document.getElementById('recover-password').style.display = 'block';
		document.getElementById('login').style.display = 'none';
	}
	function hideRecoverPasswordForm() {
		document.getElementById('recover-password').style.display = 'none';
		document.getElementById('login').style.display = 'block';
	}

	// Tự mở form quên mật khẩu khi vừa gửi yêu cầu (có thông báo) hoặc vào bằng #recover
	(function () {
		var rec = document.getElementById('recover-password');
		if (window.location.hash === '#recover' || rec.querySelector('.auth-alert')) {
			showRecoverPasswordForm();
		}

		// Nút hiện/ẩn mật khẩu
		var btn = document.querySelector('.auth-pass-toggle');
		var input = document.getElementById('customer_password');
		if (btn && input) {
			btn.addEventListener('click', function () {
				var show = input.type === 'password';
				input.type = show ? 'text' : 'password';
				btn.textContent = show ? 'Ẩn' : 'Hiện';
			});
		}
	})();
</script>

<script type="text/javascript">
(function () {
	var box = document.querySelector('.auth-social');
	if (!box) return;
	var active = 0;
	var buttons = box.querySelectorAll('.auth-social-btn');
	for (var i = 0; i < buttons.length; i++) {
		(function (btn) {
			var wrap = box.querySelector('.native-' + btn.getAttribute('data-provider'));
			var src = wrap && (wrap.querySelector('a,button,input,[onclick]') || wrap.firstElementChild);
			if (!src) { btn.style.display = 'none'; return; }
			active++;
			btn.addEventListener('click', function () { src.click(); });
		})(buttons[i]);
	}
	if (!active) {
		box.style.display = 'none';
		var d = document.querySelector('.auth-divider');
		if (d) d.style.display = 'none';
	}
})();
</script>
