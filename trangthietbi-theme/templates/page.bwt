{% include 'breadcrumb' %}
<section class="about-page">

	<div class="about-hero">
		<div class="container">
			<span class="about-eyebrow">Giới thiệu</span>
			<h1>{{ page.title }}</h1>
			<p>Đối tác cung cấp vật tư công nghiệp và thiết bị bảo hộ lao động cho nhà máy, công trình và doanh nghiệp FDI.</p>
		</div>
	</div>

	<div class="container">
		<div class="about-layout">
			<aside class="about-toc">
				<div class="about-toc-box">
					<p class="about-toc-title">Nội dung chính</p>
					<ul id="aboutToc"></ul>
				</div>
			</aside>

			<div class="about-content rte" id="aboutContent">
				{{ page.content }}
			</div>
		</div>

		<div class="about-cta">
			<h2>Cần tư vấn giải pháp vật tư và bảo hộ lao động?</h2>
			<p>Gửi nhu cầu của doanh nghiệp, đội ngũ D&amp;T sẽ phản hồi và báo giá trong thời gian sớm nhất.</p>
			<div class="about-cta-actions">
				<a href="/lien-he" class="about-btn about-btn-primary">Yêu cầu báo giá</a>
				<a href="/collections/all" class="about-btn about-btn-ghost">Xem sản phẩm</a>
			</div>
		</div>
	</div>
</section>

<style>
html { scroll-behavior: smooth; }

/* ===== Banner đầu trang ===== */
.about-hero {
	padding: 46px 0 42px;
	background: linear-gradient(135deg, #1f1f1f 0%, #3b1315 100%);
	color: #fff;
}
.about-eyebrow {
	display: inline-block;
	margin-bottom: 14px;
	padding: 4px 12px;
	border-radius: 20px;
	background: #bf2026;
	font-size: 12px;
	font-weight: 600;
	letter-spacing: .3px;
}
.about-hero h1 {
	max-width: 860px;
	margin: 0 0 12px;
	font-size: 34px;
	font-weight: 700;
	line-height: 1.28;
	color: #fff;
}
.about-hero p {
	max-width: 900px;
	margin: 0;
	font-size: 16px;
	line-height: 1.6;
	color: rgba(255, 255, 255, .82);
}

/* ===== Bố cục 2 cột ===== */
.about-layout {
	display: flex;
	align-items: flex-start;
	gap: 44px;
	padding: 40px 0 10px;
}
.about-toc {
	flex: 0 0 250px;
	position: sticky;
	top: 90px;
}
.about-toc-title {
	margin: 0 0 10px;
	font-size: 14px;
	font-weight: 700;
	color: #222;
}
.about-toc ul {
	margin: 0;
	padding: 0;
	list-style: none;
	border-left: 2px solid #eee;
}
.about-toc li a {
	display: block;
	margin-left: -2px;
	padding: 7px 14px;
	border-left: 2px solid transparent;
	font-size: 14px;
	line-height: 1.45;
	color: #666;
	text-decoration: none;
	transition: color .2s, border-color .2s;
}
.about-toc li a:hover { color: #bf2026; }
.about-toc li a.active {
	border-left-color: #bf2026;
	color: #bf2026;
	font-weight: 600;
}

/* ===== Nội dung (ghi đè style dán từ Word) ===== */
.about-content {
	flex: 1;
	min-width: 0;
	max-width: 820px;
	margin: 0;
	padding: 0;
	font-size: 16px;
	line-height: 1.8;
	color: #444;
}
.about-content p,
.about-content li,
.about-content span,
.about-content div,
.about-content a,
.about-content strong,
.about-content em,
.about-content h1,
.about-content h2,
.about-content h3,
.about-content h4 {
	font-family: inherit !important;
}
.about-content p,
.about-content li {
	margin: 0 0 14px;
	font-size: 16px !important;
	line-height: 1.8 !important;
	color: #444 !important;
	text-align: left !important;
}
.about-content span { font-size: inherit !important; color: inherit !important; background: none !important; }
.about-content strong { color: #222 !important; }

.about-content h2 {
	margin: 42px 0 14px;
	padding-left: 14px;
	border-left: 4px solid #bf2026;
	font-size: 26px !important;
	font-weight: 700;
	line-height: 1.3 !important;
	color: #1d1d1d !important;
	scroll-margin-top: 90px;
}
.about-content h2:first-child { margin-top: 0; }
.about-content h3 {
	margin: 28px 0 10px;
	font-size: 20px !important;
	font-weight: 600;
	line-height: 1.35 !important;
	color: #222 !important;
}
.about-content ul,
.about-content ol { margin: 0 0 16px; padding-left: 22px; }
.about-content img {
	display: block;
	max-width: 100%;
	height: auto !important;
	margin: 18px 0;
	border-radius: 10px;
}
.about-content table { display: block; max-width: 100%; overflow-x: auto; }

/* ===== Khối tùy chọn: thẻ Tầm nhìn / Sứ mệnh / Giá trị ===== */
.about-cards {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
	gap: 18px;
	margin: 24px 0;
}
.about-card {
	padding: 22px;
	border: 1px solid #eee;
	border-top: 3px solid #bf2026;
	border-radius: 10px;
	background: #fff;
	box-shadow: 0 6px 20px rgba(0, 0, 0, .05);
}
.about-content .about-card h3 { margin: 0 0 8px; font-size: 18px !important; }
.about-content .about-card p { margin: 0; font-size: 15px !important; }

/* ===== Khối tùy chọn: số liệu ===== */
.about-stats {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
	gap: 16px;
	margin: 24px 0;
}
.about-stat {
	padding: 18px 12px;
	border-radius: 10px;
	background: #f7f7f7;
	text-align: center;
}
.about-stat b { display: block; font-size: 28px; line-height: 1.2; color: #bf2026; }
.about-stat span { font-size: 13px; color: #666; }

/* ===== CTA cuối trang ===== */
.about-cta {
	margin: 34px 0 50px;
	padding: 38px 28px;
	border-radius: 14px;
	background: #1f1f1f;
	color: #fff;
	text-align: center;
}
.about-cta h2 { margin: 0 0 10px; font-size: 24px; font-weight: 700; color: #fff; }
.about-cta p { max-width: 560px; margin: 0 auto 22px; font-size: 15px; line-height: 1.6; color: rgba(255, 255, 255, .8); }
.about-cta-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
.about-btn {
	display: inline-block;
	padding: 12px 26px;
	border-radius: 8px;
	font-size: 15px;
	font-weight: 600;
	text-decoration: none;
	transition: background .2s, color .2s, border-color .2s;
}
.about-btn-primary { background: #bf2026; color: #fff; }
.about-btn-primary:hover { background: #a01a20; color: #fff; }
.about-btn-ghost { border: 1px solid rgba(255, 255, 255, .5); color: #fff; }
.about-btn-ghost:hover { background: #fff; color: #1f1f1f; }

/* ===== Responsive ===== */
@media (max-width: 991px) {
	.about-toc { display: none; }
	.about-layout { display: block; padding-top: 28px; }
	.about-content { max-width: none; }
}
@media (max-width: 767px) {
	.about-hero { padding: 32px 0 28px; }
	.about-hero h1 { font-size: 24px; }
	.about-content h2 { font-size: 22px !important; }
	.about-cta { padding: 28px 18px; }
}
</style>

<script type="text/javascript">
(function () {
	var content = document.getElementById('aboutContent');
	if (!content) return;

	// Trang chỉ nên có 1 H1: hạ H1 trong nội dung xuống H2
	var h1s = content.querySelectorAll('h1');
	for (var i = 0; i < h1s.length; i++) {
		var h = document.createElement('h2');
		h.innerHTML = h1s[i].innerHTML;
		h1s[i].parentNode.replaceChild(h, h1s[i]);
	}

	// Mục lục tự sinh từ các H2
	var heads = content.querySelectorAll('h2');
	var toc = document.getElementById('aboutToc');
	var box = document.querySelector('.about-toc');
	if (!toc || heads.length < 2) {
		if (box) box.style.display = 'none';
		return;
	}

	var links = [];
	for (var j = 0; j < heads.length; j++) {
		var head = heads[j];
		head.id = head.id || ('muc-' + (j + 1));
		var li = document.createElement('li');
		var a = document.createElement('a');
		a.href = '#' + head.id;
		a.textContent = head.textContent.replace(/\s+/g, ' ').trim();
		li.appendChild(a);
		toc.appendChild(li);
		links.push(a);
	}

	// Tô sáng mục đang đọc
	function onScroll() {
		var current = 0;
		for (var k = 0; k < heads.length; k++) {
			if (heads[k].getBoundingClientRect().top <= 140) current = k;
		}
		for (var m = 0; m < links.length; m++) {
			links[m].className = (m === current) ? 'active' : '';
		}
	}
	window.addEventListener('scroll', onScroll);
	onScroll();
})();
</script>
