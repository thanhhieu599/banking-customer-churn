{% assign variantCount = product.variants | size %}
{% assign on_var = false %}
{% if variantCount > 1 %}
{% assign on_var = true %}
{% endif %}
{%assign contact = false%}
{%if product.price == 0 %}
{%assign contact = true%}
{%endif%}
{% include 'breadcrumb' %}
{% if settings.product_recent_enable %}
<script src='https://cdnjs.cloudflare.com/ajax/libs/jquery-cookie/1.4.1/jquery.cookie.min.js' type='text/javascript'></script>
{%endif%}
<section class="product" itemscope itemtype="http://schema.org/Product">	
	<meta itemprop="mpn" content="{{ product.id }}" />
	<meta itemprop="image" content="https:{{ product.featured_image.src | img_url: 'grande' }}">
	<meta itemprop="description" content="{{ product.content | strip_html | truncate: 300 }}">
	<meta itemprop="name" content="{{ product.name | escape}}">
	<div class="container">
		<div class="row">
			<div class="details-product clearfix">
				<div class="col-lg-9 col-md-9 col-xs-12">
					<div class="row">
						<div class="col-xs-12 col-sm-12 col-md-6">
							<div id="product" class="relative product-image-block {% if product.images.size < 2  %}no-thum{%endif%}">
								<div class="large-image">
									{%if product.featured_image.alt ==""%}
									{% assign featured_image_alt = product.name %}
									{%else%}
									{% assign featured_image_alt = product.featured_image.alt%}
									{%endif%}
									<a rel="nofollow" {%if settings.product_lightbox_enable%}{%if product.images.size  > 0 %}href="{{ product.featured_image.src | img_url:'1024x1024' }}" data-rel="prettyPhoto[product-gallery]"{% endif %}{%endif %} class="large_image_url">
										<img {%if product.images.size  > 0 %}id="zoom_01"{%endif%} src="{{ product.featured_image.src | img_url:'1024x1024' }}" alt="{{ product.name }}" class="img-responsive center-block">
									</a>							
									<div class="hidden">
										{% for image in product.images offset: 1 %}
										{%if image.alt == "" or image.alt == null %}
										{% assign alt = product.name %}
										{% assign check_image = 0 %}
										{%else%}
										{% assign alt = image.alt %}
										{% assign check_image = 1 %}
										{%endif%}
										<div class="item">
											<a rel="nofollow" href="{{ image.src }}" data-image="{{ image.src }}" data-zoom-image="{{ image.src }}" data-rel="prettyPhoto[product-gallery]">										
											</a>
										</div>	
										{% endfor %}
									</div>
								</div>
								{% if product.images.size  > 1 and settings.product_thumb_enable %}
								{% if product.variants.size > 1 and check_image == 1 %}

								{% for option in product.options %}
								{% if option == 'Màu sắc' or option == 'Màu' or option == 'màu sắc' or option == 'màu' %}
								{% assign check = 1 %}
								{% break %}
								{% else %}
								{% assign check = 0 %}
								{% endif %}
								{% endfor %}

								{% if check == 1 %}
								{% for option in product.options %}
								{% if option == 'Màu sắc' or option == 'Màu' or option =='màu sắc' or option == 'màu' %}
								{% assign featured_alts = forloop.index %}
								{% if featured_alts == 1 %}
								{% assign featured_alt = product.selected_or_first_available_variant.option1 %}
								{% elsif featured_alts == 2 %}
								{% assign featured_alt = product.selected_or_first_available_variant.option2 %}
								{% elsif featured_alts == 3 %}
								{% assign featured_alt = product.selected_or_first_available_variant.option3 %}
								{% else %}
								{% assign featured_alt = product.selected_or_first_available_variant.option4 %}
								{% endif %}
								{% endif %}
								{% endfor %}
								<div id="gallery_01" class="ababcbc owl-carousel owl-theme thumbnail-product a a0 {{ check_image }}">
									{% for image in product.images %}
									{% if image.alt == featured_alt or image == featured_image %}
									<div class="item">
										<a href="javascript:void(0);" data-image="{{ image.src }}" data-zoom-image="{{ image.src | img_url:'grande' }}">
											<img  data-image="{{ image.src | img_url:'1024x1024'}}" src="{{ image.src | img_url:'small' }}" alt="{{ product.name }}">
										</a>
									</div>
									{% endif %}
									{% endfor %}
								</div>
								{% else %}
								<div id="gallery_01" class="owl-carousel owl-theme thumbnail-product abc a1 {{ check }} {{ featured_alts }}">
									{% for image in product.images %}
									<div class="item">
										<a href="javascript:void(0);" data-image="{{ image.src| img_url:'1024x1024' }}" data-zoom-image="{{ image.src | img_url:'grande' }}"><img data-image="{{ image.src| img_url:'1024x1024' }}" src="{{ image.src | img_url:'small' }}" alt="{{ product.name }}"></a>
									</div>
									{% endfor %}
								</div>
								{% endif %}
								{% else %}
								<div id="gallery_01" class="owl-carousel owl-theme thumbnail-product abc a2">
									{% for image in product.images %}
									<div class="item">
										<a href="javascript:void(0);" data-image="{{ image.src| img_url:'1024x1024' }}" data-zoom-image="{{ image.src | img_url:'grande' }}"><img data-image="{{ image.src| img_url:'1024x1024' }}" src="{{ image.src | img_url:'small' }}" alt="{{ product.name }}"></a>
									</div>
									{% endfor %}
								</div>
								{%endif%}
								{% endif %}
							</div>
							{%if settings.product_social_enable %}
							<div class="social-sharing">
								{%include 'social-sharing'%}
							</div>
							{%endif%}
						</div>
						<div class="col-xs-12 col-sm-12 col-md-6 details-pro">
							<h1 class="title-head">{{ product.name }}</h1>
							<div class="item-brand">
								<div class="sapo-product-reviews-badge sapo-product-reviews-badge-detail" data-id="{{ product.id }}"></div>
							</div>
							<div class="stock-brand">
								<ul>
									<li class="inventory_quantity">
										<span class="stock-brand-title">Tình trạng:</span>
										{% assign variant = product.variants[0] %}
										{% if variant.inventory_management == 'bizweb' %}
										{% if variant.inventory_quantity <= 0 and variant.inventory_policy == 'deny' %}
										<span class="a-stock a0">Hết hàng</span>
										{% elsif variant.inventory_quantity <= 0 and variant.inventory_policy == 'continue' %}
										<span class="a-stock a1">Còn hàng</span>
										{% endif %}
										{% else %}
										<span class="a-stock a2">Còn hàng</span>
										{% endif %}
									</li>
									<li>
										{% if product.vendor == null or product.vendor == '' %}
										<span class="stock-brand-title">Thương hiệu:</span>
										<span class="a-brand" itemprop="brand" itemscope itemtype="https://schema.org/brand">Đang cập nhật</span>
										{% else %}
										<span class="stock-brand-title">Thương hiệu:</span>
										<span class="a-brand" itemprop="brand" itemscope itemtype="https://schema.org/brand">
											<a href="/collections/all?q=vendor:({{product.vendor}})&page=1&view=grid">
												{{product.vendor}}
											</a>
										</span>
										{% endif %}
									</li>
									<li>
										{{product.summary}}
									</li>
									<li class="sku-product hidden">
										<span class="variant-sku" itemprop="sku" content="{% if product.selected_or_first_available_variant.sku != "" and product.selected_or_first_available_variant.sku != null %}{{ product.selected_or_first_available_variant.sku }}{% elsif product.sku != "" and product.sku != null %}{% else %}Đang cập nhật{% endif %}">{% if product.selected_or_first_available_variant.sku != "" and product.selected_or_first_available_variant.sku != null %}{{ product.selected_or_first_available_variant.sku }}{% elsif product.sku != "" and product.sku != null %}{% else %}(Đang cập nhật...){% endif %}</span>
									</li>
								</ul>
							</div>
							<div class="price-box" itemprop="offers" itemscope="" itemtype="http://schema.org/Offer">
								<link itemprop="url" href="https:{{ store.url }}{{ product.url }}" />
								<meta itemprop="priceValidUntil" content="2030-11-05" />
								{% include 'detail-inventory' %}
								{%if on_var%}
								<span class="special-price">
									<span class="price product-price">{{ product.variants[0].price | money }}</span>
									<meta itemprop="price" content="{{ product.variants[0].price | money_without_currency  | remove: '.' }}">
									<meta itemprop="priceCurrency" content="{{ store.currency }}">
								</span> <!-- Giá Khuyến mại -->
								<span class="old-price" itemprop="priceSpecification" itemscope="" itemtype="http://schema.org/priceSpecification">
									Giá thị trường:  <del class="price product-price-old">{% if product.variants[0].compare_at_price > 0 %}{{ product.variants[0].compare_at_price | money }}{% endif %}</del>
									<meta itemprop="price" content="{% if product.variants[0].compare_at_price > 0 %}{{ product.variants[0].compare_at_price | money_without_currency  | remove: '.' }}{% else %}0{% endif %}">
									<meta itemprop="priceCurrency" content="{{ store.currency }}">
								</span> <!-- Giá gốca -->
								<span class="save-price">Tiết kiệm:  <span class="price product-price-save">{% if product.variants[0].compare_at_price > 0 %}{{ product.variants[0].compare_at_price | minus: product.variants[0].price | money }}{% endif %}</span>
									<meta itemprop="priceCurrency" content="{{ store.currency }}">
								</span> <!-- Tiết kiệm -->
								{%elseif contact%}
								<div class="special-price">
									<span class="price product-price">Liên hệ</span>
									<meta itemprop="price" content="0">
									<meta itemprop="priceCurrency" content="{{ store.currency }}">
								</div>
								{%elseif product.variants[0].compare_at_price > product.variants[0].price%}
								<span class="special-price">
									<span class="price product-price">{{ product.variants[0].price | money }}</span>
									<meta itemprop="price" content="{{ product.variants[0].price | money_without_currency  | remove: '.' }}">
									<meta itemprop="priceCurrency" content="{{ store.currency }}">
								</span> <!-- Giá Khuyến mại -->
								<span class="old-price" itemprop="priceSpecification" itemscope="" itemtype="http://schema.org/priceSpecification">
									Giá thị trường:  <del class="price product-price-old">{{ product.variants[0].compare_at_price | money }}</del>
									<meta itemprop="price" content="{% if product.variants[0].compare_at_price > 0 %}{{ product.variants[0].compare_at_price | money_without_currency  | remove: '.' }}{% else %}0{% endif %}">
									<meta itemprop="priceCurrency" content="{{ store.currency }}">
								</span>
								<span class="save-price">Tiết kiệm:  <span class="price product-price-save">{{ product.variants[0].compare_at_price | minus: product.variants[0].price | money }}</span> </span> <!-- Tiết kiệm -->
								{% else %}
								<div class="special-price">
									<span class="price product-price">{{ product.variants[0].price | money }}</span>
									<meta itemprop="price" content="{{ product.variants[0].price | money_without_currency  | remove: '.' }}">
									<meta itemprop="priceCurrency" content="{{ store.currency }}">
								</div>
								{% endif %}
							</div>
							<div class="quote-product-cta">
								<button type="button" class="quote-request-button" data-quote-open data-quote-product="{{ product.name | escape }}" data-quote-url="{{ shop.url }}{{ product.url }}">Yêu cầu báo giá</button>
							</div>
							<div class="taxable1">
								<em>{% if product.variants[0].taxable == true %}<span style="color: green">{{ 'Giá sản phẩm đã bao gồm VAT' }}</span>
									{% elsif product.variants[0].taxable == false %}<span style="color: red">{{ 'Giá sản phẩm chưa bao gồm VAT' }}</span>{% endif %}
								</em>
							</div>

							<div class="form-product">
								<form enctype="multipart/form-data" id="add-to-cart-form" action="/cart/add" method="post" class="form-inline">
									{% if settings.product_swatch_enable and product.variants.size > 1 %}
									{% for option in product.options %}
									{% include 'swatch' with option %}
									{% endfor %}
									{% endif %}
									<div class="box-variant clearfix {% if settings.product_swatch_enable%} hidden {%endif%}">
										{% if variantCount > 1 %} 
										<fieldset class="form-group">
											<select id="product-selectors" class="form-control form-control-lg" name="variantId" style="display:none">
												{% for variant in product.variants %}
												<option {% if variant == product.selected_or_first_available_variant %} selected="selected" {% endif %} value="{{ variant.id }}">{{ variant.title }} - {{ variant.price | money }}</option>
												{% endfor %}
											</select>
										</fieldset>
										{% else %}
										<input type="hidden" name="variantId" value="{{ product.variants[0].id }}" />
										{% endif %}
									</div>
									
									<div class="form-group {%if contact%}hidden{%endif%} clearfix">
										<div class="custom custom-btn-number form-control">									
											<input type="text" class="input-text qty number-sidebar" data-field='quantity' title="Số lượng" size="4" value="1" id="qty" name="quantity" onkeypress="if ( isNaN(this.value + String.fromCharCode(event.keyCode) )) return false;" onchange="if(this.value == 0)this.value=1;" />
											<div class="gp-btn">
												<button onclick="var result = document.getElementById('qty'); var qty = result.value; if( !isNaN(qty)) result.value++;return false;" class="btn-plus btn-cts" type="button">+</button>
												<button onclick="var result = document.getElementById('qty'); var qty = result.value; if( !isNaN(qty) & qty > 1 ) result.value--;return false;" class="btn-minus btn-cts" type="button">–</button>
											</div>
										</div>
										{% if product.available %}									
										<button type="submit" class="btn btn-lg btn-gray btn-cart add_to_cart btn_buy add_to_cart" title="Mua ngay">
											<span>Mua ngay</span>
										</button>									
										{% else %}
										<button class="btn btn-lg btn-style btn-style-active btn-cart" title="Hết hàng" disabled="disabled" ><span>Hết hàng</span></button>
										{% endif %}								
									</div>
									
								<div class="abps-productdetail ab-hide" ab-data-productid="{{product.id}}"></div></form>
								<div class="clearfix"></div>
							</div>
							{% assign product_pdf_download_url = product.metafields.custom.pdf_download_url.value | default: product.metafields.custom.pdf_download_url %}
							{% if settings.product_guide_url != blank or product_pdf_download_url != blank %}
								<p class="product-guide-links" style="margin: 10px 0; display: flex; align-items: center; gap: 14px;">
								  {% if settings.product_guide_url != blank and settings.product_guide_text != blank %}<a href="{{ settings.product_guide_url | escape }}" target="_blank" rel="noopener noreferrer">{{ settings.product_guide_text | escape }}</a>{% endif %}
								  {% if product_pdf_download_url != blank %}<a href="{{ product_pdf_download_url | escape }}" target="_blank" rel="noopener noreferrer" title="Tải file PDF" aria-label="Tải file PDF" style="display: inline-flex;"><img src="{{ 'product_pdf_icon.png' | asset_url }}" alt="PDF" loading="lazy" style="display: block; width: 36px; height: 36px; object-fit: contain;" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';"><span aria-hidden="true" style="display: none; width: 36px; height: 36px; align-items: center; justify-content: center; box-sizing: border-box; border: 2px solid #d92d20; border-radius: 3px; color: #d92d20; font-size: 10px; font-weight: 700; line-height: 1;">PDF</span></a>{% endif %}
								</p>
								{% endif %}
							<div class="product-summary product_description ahahah margin-bottom-15">
								<div class="rte description">
									<a href="/" style="font-weight: bold; color: #be2326;">TRANGTHIETBI.VN</a> Cung cấp sản phẩm, dịch vụ, giao hàng toàn quốc <b>UY TÍN SỐ 1 VIỆT NAM</b><br>
									<b><i class="fa fa-home"></i> VPGD: 87 đường 16, KDC Phong Phú 4, Phong Phú, Bình Chánh, TP. Hồ Chí Minh</b><br>
									<b><i class="fa fa-clock-o"></i> Thời gian hoạt động:</b><br>
									Từ 8h - 19h00 Thứ 2 đến thứ 6<br>
									Từ 8h - 17h30 Thứ 7 & Chủ nhật<br>
									<b><i class="fa fa-comments"></i> Chat với Trang Thiết Bị:</b>
									<ul class="product-social-support">										
										<li>
											<a target="_blank" href="{{ settings.product_social_mesenger }}" rel="nofollow">
												<img src="{{ 'social_mesenger.png' | asset_url }}" alt="Mesenger"> trangthietbi.vn
											</a>
										</li>
										<li>
											<a target="_blank" href="https://zalo.me/{{ settings.product_social_zalo }}" rel="nofollow">
												<img src="{{ 'social_zalo.png' | asset_url }}" alt="Zalo"> {{ settings.product_social_zalo }}
											</a>
										</li>
										<li>
											<a target="_blank" href="skype:{{ settings.product_social_skype }}?call" rel="nofollow">
												<img src="{{ 'social_skype.png' | asset_url }}" alt="Skype"> {{ settings.product_social_skype }}
											</a>
										</li>
									</ul>
									<b><i class="fa fa-phone-square"></i> Khiếu nại & bảo hành:</b><br>
									028 6655 1579 - 0933 568 088<br>
									<i class="fa fa-envelope"></i> Email: hotro@dt-safety.com
								</div>
							</div>
							<div class="product-sidebar-ant-fashion hidden-lg hidden-md">
								{% include 'product_promotion_mobile' %}
								{% if settings.product_hotline_enable %}
								<div class="box-hotlines clearfix">
									<div class="box-hotlines-left">
										<h3>{{ settings.product_hotline_title }}</h3>
										<p>{{ settings.product_hotline_title_1 }}</p>
										{% if settings.store_edit %}
										<h2><a href="tel:{{ settings.store_phone| remove: ' ' }}" title="{{ settings.store_phone }}">{{ settings.store_phone }}</a></h2>
										{% else %}
										<h2><a href="tel:{{ store.phone_number| remove: ' ' }}" title="{{store.phone_number }}">{{store.phone_number }}</a></h2>
										{% endif %}
										<div class="link-contact">
											<a href="{{ settings.product_hotline_title_5 }}" title="{{ settings.product_hotline_title_4 }}">{{ settings.product_hotline_title_4 }}</a>
										</div>
									</div>
									<div class="box-hotlines-right">
										{% if settings.store_edit %}
										<a href="tel:{{ settings.store_phone | remove: ' ' }}">
											<i class="fa fa-phone" aria-hidden="true"></i>
										</a>
										{% else %}
										<a href="tel:{{ store.phone_number | remove: ' ' }}">
											<i class="fa fa-phone" aria-hidden="true"></i>
										</a>
										{% endif %}
									</div>
								</div>
								{% endif %}
							</div>
						</div>
						{%if settings.product_tab_enable %}
						<div class="col-xs-12 col-sm-12 col-md-12 margin-top-15 margin-bottom-10">
							<div class="bs-example bs-example-tabs" role="tabpanel" data-example-id="togglable-tabs">
								<ul id="myTab" class="nav nav-tabs nav-tabs-responsive" role="tablist">
									<li role="presentation" class="active">
										<a href="#home" id="home-tab" role="tab" data-toggle="tab" aria-controls="home" aria-expanded="true">
											<span class="text">{{settings.product_tab1_title}}</span>
										</a>
									</li>
									{%if settings.product_tab2_enable%}
									<li role="presentation" class="next">
										<a href="#profile" role="tab" id="profile-tab" data-toggle="tab" aria-controls="profile">
											<span class="text">{{ pages[settings.index_blog_intro_title].title }}</span>
										</a>
									</li>
									{%endif%}
									{%if settings.product_tab3_enable%}
									<li role="presentation">
										<a href="#samsa" role="tab" id="samsa-tab" data-toggle="tab" aria-controls="samsa">
											<span class="text">{{ pages[settings.index_blog_intro_title_1].title }}</span>
										</a>
									</li>
									{%endif%}
									<li role="presentation">
										<a href="#samsa4" role="tab" id="samsa-tab4" data-toggle="tab" aria-controls="samsa4">
											<span class="text">Đánh giá</span>
										</a>
									</li>
								</ul>
								<div id="myTabContent" class="tab-content">
									<div role="tabpanel" class="tab-pane fade in active" id="home" aria-labelledby="home-tab">
										{% if product.content != '' %}
										<div class="well product-well">
											<div class="row ababa">
												<div class="col-md-12">
													{{ product.content }}
												</div>
											</div>
											<a class="btn btn-default btn--view-more">
												<span class="more-text">Xem thêm <i class="fa fa-chevron-down"></i></span>
												<span class="less-text">Thu gọn <i class="fa fa-chevron-up"></i></span>
											</a>
										</div>
										{% else %}
										Nội dung đang cập nhật
										{% endif %}
									</div>
									{%if settings.product_tab2_enable%}
									<div role="tabpanel" class="tab-pane fade" id="profile" aria-labelledby="profile-tab">
										{{ pages[settings.index_blog_intro_title].content }}
									</div>
									{%endif%}
									{%if settings.product_tab3_enable%}
									<div role="tabpanel" class="tab-pane fade" id="samsa" aria-labelledby="samsa-tab">
										{{ pages[settings.index_blog_intro_title_1].content }}
									</div>
									{%endif%}
									<div role="tabpanel" class="tab-pane fade" id="samsa4" aria-labelledby="samsa-tab4">
										{% include 'product-reviews' %}
									</div>
								</div>
							</div>
						</div>
						{%endif%}
					</div>
				</div>
				<div class="col-lg-3 col-md-3 col-xs-12">
					<div class="product-sidebar-ant-fashion">
						{% if settings.product_hotline_enable %}
						<div class="box-hotlines clearfix hidden-sm hidden-xs">
							<div class="box-hotlines-left">
								<h3>{{ settings.product_hotline_title }}</h3>
								<p>{{ settings.product_hotline_title_1 }}</p>
								{% if settings.store_edit %}
								<h2><a href="tel:{{ settings.store_phone | remove: ' ' }}" title="{{ settings.store_phone }}">{{ settings.store_phone }}</a></h2>
								{% else %}
								<h2><a href="tel:{{ store.phone_number | remove: ' ' }}" title="{{store.phone_number }}">{{store.phone_number }}</a></h2>
								{% endif %}
								<div class="link-contact">
									<a href="{{ settings.product_hotline_title_5 }}" title="{{ settings.product_hotline_title_4 }}">{{ settings.product_hotline_title_4 }}</a>
								</div>
							</div>
							<div class="box-hotlines-right">
								{% if settings.store_edit %}
								<a href="tel:{{ settings.store_phone | remove: ' ' }}" title="{{ settings.store_phone | remove: ' ' }}">
									<i class="fa fa-phone" aria-hidden="true"></i>
								</a>
								{% else %}
								<a href="tel:{{ store.phone_number | remove: ' ' }}" title="{{ store.phone_number | remove: ' ' }}">
									<i class="fa fa-phone" aria-hidden="true"></i>
								</a>
								{% endif %}
							</div>
						</div>
						{% endif %}
						{% include 'product_promotion' %}
						{% if settings.product_recent_enable %}
						{% include 'product_recently' %}
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</div>
	{% assign check11 = product.url %}
	{% assign productRelate = product.collections.first.alias %}
	{% assign productRelateCheck = product.collections.size %}
	{% if productRelateCheck > 0 and settings.product_upsell_enable %}
	{% for product in collections[productRelate].products limit: 9%}
	{% unless check11 == product.url %}
	{% assign a = forloop.length %}
	{% endunless %}
	{% endfor %}
	{% if a > 0 %}
	<div class="product-page-relative">
		<div class="container">
			<div class="row">
				<div class="col-md-12">
					<div class="related-product collections-container">
						<div class="feature_category_title text-center">
							<h2 class="title-head text-center">Sản phẩm cùng loại</h2>
						</div>
						<div class="products  owl-carousel owl-theme products-view-grid" data-md-items="6" data-sm-items="4" data-xs-items="2" data-margin="0">
							{% for product in collections[productRelate].products limit: 8%}
							{% unless check11 == product.url %}
							<div class="item">
								{%include 'product-grid-item'%}
							</div>
							{% endunless %}
							{% endfor %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
{% endif %}
{% endif %}	
<script> 
	var product = {{ product | json }};
	var selectCallback = function(variant, selector) {
		if (variant) {

			var form = jQuery('#' + selector.domIdPrefix).closest('form');

			for (var i=0,length=variant.options.length; i<length; i++) {

				var radioButton = form.find('.swatch[data-option-index="' + i + '"] :radio[value="' + variant.options[i] +'"]');
				//console.log(radioButton);
				if (radioButton.size()) {
					radioButton.get(0).checked = true;
				}
			}
		}

		if (variant){
			if (variant.taxable){
				$('.taxable em').html('Giá sản phẩm đã bao gồm VAT');
			} else {
				$('.taxable em').text('Giá sản phẩm chưa bao gồm VAT');
			}
		}

		var addToCart = jQuery('.form-product .btn-cart'),
			form = jQuery('.form-product .form-group'),
			productPrice = jQuery('.details-pro .special-price .product-price'),
			qty = jQuery('.inventory_quantity .a-stock'),
			comparePrice = jQuery('.details-pro .old-price .product-price-old'),
			comparePriceText = jQuery('.details-pro .old-price'),
			savePrice = jQuery('.details-pro .save-price .product-price-save'),
			savePriceText = jQuery('.details-pro .save-price'),
			qtyBtn = jQuery('.form-product .form-group .custom-btn-number'),
			max = jQuery('.form-product .form-group .qty'),
			product_sku = jQuery('.details-pro .sku-product .variant-sku');
		if (variant && variant.sku != "" && variant.sku != null) {
			product_sku.html(variant.sku);
		} else {
			product_sku.html('(Đang cập nhật...)');
		}
		if (variant && variant.available) {
			if(variant.inventory_management == "bizweb"){
				if (variant.inventory_quantity != 0) {
					qty.html('<span class="a-stock">Chỉ còn ' + variant.inventory_quantity +' sản phẩm</span>');
					max.attr("max", variant.inventory_quantity);
					max.val(1);
				} else if (variant.inventory_quantity == ''){
					qty.html('<span class="a-stock a-stock-out">Hết hàng</span>');
				}
			}else{
				qty.html('<span class="a-stock">Còn hàng</span>');
			}
			addToCart.text('Mua ngay').removeAttr('disabled');	
			qtyBtn.removeClass('hidden');
			if(variant.price == 0){
				productPrice.html('Liên hệ');	
				comparePrice.hide();
				savePrice.hide();
				comparePriceText.hide();
				savePriceText.hide();
				form.addClass('hidden');
				$('.taxable em').html('');
			}else{
				form.removeClass('hidden');
				productPrice.html(Bizweb.formatMoney(variant.price, "{{ store.money_format }}"));
													 // Also update and show the product's compare price if necessary
													 if ( variant.compare_at_price > variant.price ) {
								  comparePrice.html(Bizweb.formatMoney(variant.compare_at_price, "{{ store.money_format }}")).show();
								  savePrice.html(Bizweb.formatMoney(variant.compare_at_price - variant.price, "{{ store.money_format }}")).show();
								  comparePriceText.show();
				savePriceText.show();
			} else {
				comparePrice.hide();   
				savePrice.hide();
				comparePriceText.hide();
				savePriceText.hide();
			}       										
		}

	} else {	
		qty.html('<span class="a-stock a-stock-out">Hết hàng</span>');
		addToCart.text('Hết hàng').attr('disabled', 'disabled');
		qtyBtn.addClass('hidden');
		if(variant){
			if(variant.price != 0){
				form.removeClass('hidden');
				productPrice.html(Bizweb.formatMoney(variant.price, "{{ store.money_format }}"));
													 // Also update and show the product's compare price if necessary
													 if ( variant.compare_at_price > variant.price ) {
								  comparePrice.html(Bizweb.formatMoney(variant.compare_at_price, "{{ store.money_format }}")).show();
								  savePrice.html(Bizweb.formatMoney(variant.compare_at_price - variant.price, "{{ store.money_format }}")).show();
								  comparePriceText.show();
				savePriceText.show();
			} else {
				comparePrice.hide();  
				savePrice.hide();
				comparePriceText.hide();
				savePriceText.hide();
			}     
		}else{
			productPrice.html('Liên hệ');	
			comparePrice.hide();
			savePrice.hide();
			comparePriceText.hide();
			savePriceText.hide();
			form.addClass('hidden');	
			$('.taxable em').html('');
		}
	}else{
		productPrice.html('Liên hệ');	
		comparePrice.hide();
		savePrice.hide();
		comparePriceText.hide();
		savePriceText.hide();
		form.addClass('hidden');	
		$('.taxable em').html('');
	}

	}
	/*begin variant image*/
	if (variant && variant.image) {  
		var originalImage = jQuery(".large-image img"); 
		var stickoriginalImage = jQuery(".productAnchor_horizonalNav img");
		var newImage = variant.image;
		var element = originalImage[0];
		Bizweb.Image.switchImage(newImage, element, function (newImageSizedSrc, newImage, element) {
			jQuery(element).parents('a').attr('href', newImageSizedSrc);
			jQuery(element).attr('src', newImageSizedSrc);
			jQuery(stickoriginalImage).attr('src', newImageSizedSrc);
		});
		$('.large-image .checkurl').attr('href',$(this).attr('src'));
		if($(window).width() > 1200){
			setTimeout(function(){
				$('.zoomContainer').remove();
				$('#zoom_01').elevateZoom({
					gallery: 'gallery_01',
					zoomWindowOffetx: 0,
					zoomWindowOffety: 0,
					zoomType: "inner",
					easing: true,
					scrollZoom: false,
					cursor: 'pointer',
					galleryActiveClass: 'active',
					imageCrossfade: true
				});
			},300);
		}
	}

	/*end of variant image*/
	};
	jQuery(function($) {
		{% if  product.variants.size > 1 %}
		new Bizweb.OptionSelectors('product-selectors', {
			product: {{ product | json }},
			onVariantSelected: selectCallback, 
			enableHistoryState: true
		});      

		{% endif %}

		// Add label if only one product option and it isn't 'Title'. Could be 'Size'.
		{% if product.options.size == 1 and product.options.first != 'Title' %}
		$('.selector-wrapper:eq(0)').prepend('<label>{{ product.options.first }}</label>');
											 {% endif %}

											 // Hide selectors if we only have 1 variant and its title contains 'Default'.
											 {% if product.variants.size == 1 and product.variants.first.title contains 'Default' %}
											 $('.selector-wrapper').hide();
		{% endif %} 
		$('.selector-wrapper').css({
			'text-align':'left',
			'margin-bottom':'15px'
		});
	});
	jQuery('.swatch :radio').change(function() {
		var optionIndex = jQuery(this).closest('.swatch').attr('data-option-index');
		var optionValue = jQuery(this).val();
		jQuery(this)
			.closest('form')
			.find('.single-option-selector')
			.eq(optionIndex)
			.val(optionValue)
			.trigger('change');
	});
	$(document).ready(function() {
		if($(window).width() > 1200){
			$('#zoom_01').elevateZoom({
				gallery: 'gallery_01',
				zoomWindowOffetx: 0,
				zoomWindowOffety: 0,
				zoomType: "inner",
				easing: true,
				scrollZoom: false,
				cursor: 'pointer',
				galleryActiveClass: 'active',
				imageCrossfade: true
			});
		}
		jQuery("#gallery_01").owlCarousel({
			loop:false,
			margin:10,
			responsiveClass:true,
			dots:false,
			nav:true,
			items: 4,
			responsive:{
				0:{
					items:4		
				},
				600:{
					items:4	
				},
				1000:{
					items:4	
				}
			}
		});
	});
	$('#gallery_01 img').click(function(e){
		e.preventDefault();
		$('.large-image img').attr('src',$(this).parent().attr('data-zoom-image'));
	})
	$('#gallery_01 img, .swatch-element label').click(function(e){
		$('.checkurl').attr('href',$(this).attr('data-image'));	
		if($(window).width() > 1200){
			setTimeout(function(){
				$('.zoomContainer').remove();				
				$('#zoom_01').elevateZoom({
					gallery: 'gallery_01',
					zoomWindowOffetx: 0,
					zoomWindowOffety: 0,
					zoomType: "inner",
					easing: true,
					scrollZoom: false,
					cursor: 'pointer',
					galleryActiveClass: 'active',
					imageCrossfade: true
				});
			},300);
		}
	})
</script>
{% if  product.variants.size > 1 and check_image == 1 %}
<script>
	jQuery(document).ready(function($){
		var images = [];
		{% for image in product.images %}
		images.push({url: "{{ image.src | product_img_url: 'grande'  }}", alt: "{{ image.alt }}"});
					 {% endfor %}
					 var thumbnails = $(".thumbnail-product");
					 {% for option in product.options %}
					 {% if option == 'Màu sắc' or option == 'Màu' or option =='màu sắc' or option == 'màu' %}
					 {% assign featured_alts = forloop.index0 %}
					 {% endif %}
					 {% endfor %}
					 $('#product-selectors-option-{{ featured_alts }}').change(function() {
					 var selected = $(this).val(), mainImage = jQuery('.large-image img').attr('src').replace('_2048x2048', '_grande');
					 thumbnails.hide().html("");
					 arr = [];
					 var addImage = $.each( images, function( i, image ) {
					 var alt = images[i].alt, url = images[i].url;   
					 if (alt == selected) {
					 thumbnails.append('<div class="item"><a href="javascript:void(0);" data-image="' + url + '" data-zoom-image="' + url.replace('_medium', '_1024x1024') + '"><img  src="' + Bizweb.resizeImage(url, 'compact') + '" alt="'+ alt +'"></a></div>');
					}
					});
		arr.push(addImage);
		$.when.apply($, arr).done(function () {
			$('#gallery_01').trigger('destroy.owl.carousel');
			$('#gallery_01').removeAttr("style");
			jQuery("#gallery_01").owlCarousel({
				loop:false,
				margin:10,
				responsiveClass:true,
				dots:false,
				nav:true,
				responsive:{
					0:{
						items:4		
					},
					600:{
						items:4	
					},
					1000:{
						items:4	
					}
				}
			});
			thumbnails.fadeIn();
			$('#gallery_01 .item a').on('click', function(e) { 
				e.preventDefault();
			});
		});
	});
	});
</script>
{% endif %}
<script>
	jQuery(document).ready(function($){
		var el = document.getElementById("qty");
		$("#qty").change(function() {
			var max = parseInt(el.getAttribute("max")) || 10000;
			console.log(el.value);
			var value = parseInt(jQuery(this).val(), 10) || 0;
			if (value > max) {
				alert('We only have ' + max + ' of this item in stock');
				jQuery(this).val(max);
			}
		});
	});
	function eatFood() {
		var el = document.getElementById("qty");
		var maxs = parseInt(el.getAttribute("max")) || 10000;
		var result = document.getElementById('qty');
		var qty = result.value;
		if( !isNaN(qty) & qty < maxs) result.value++;
		return false;
	}
</script>
{% include 'appbulk-selling-products' %}
<div class="ab-most-view-product-module ab-hide"></div>
