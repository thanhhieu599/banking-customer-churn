<header class="header">
	<div class="top-header">
		<div class="container">
			<div class="row">
				<div class="col-md-3 col-sm-6 col-xs-5 col-100-h">
					<a href="/" class="logo-wrapper">					
						<img src="{{ 'logo.png' | asset_url }}" alt="logo {{ store.name }}" />					
					</a>
				</div>
				<div class="col-100-h col-sm-6 col-xs-7 hidden-lg hidden-md">
					<div class="hotline">
						{% if settings.store_edit %}
						<a href="tel:{{ settings.store_phone | remove: ' '}}" title="{{ settings.store_phone | remove: ' '}}">{{ settings.store_phone }}</a>
						{% else %}
						<a href="tel:{{ store.phone_number | remove: ' '}}" title="{{ store.phone_number | remove: ' '}}">{{ store.phone_number }}</a>
						{% endif %}
						<span>{{ settings.store_text }}</span>
					</div>
				</div>
				<div class="col-md-5">
					<button type="button" class="navbar-toggle collapsed visible-sm visible-xs" id="trigger-mobile">
						<span class="sr-only">Toggle navigation</span>
						<span class="icon-bar"></span>
						<span class="icon-bar"></span>
						<span class="icon-bar"></span>
					</button>
					<div class="search-auto clearfix">
						<form class="input-group search-bar search_form" action="/search" method="get" role="search">		
							<input type="search" name="query" value="" placeholder="Bạn tìm gì..." class="input-group-field st-default-search-input search-text auto-search-ant" autocomplete="off">
							<span class="input-group-btn">
								<button class="btn icon-fallback-text">
									<i class="fa fa-search"></i>
								</button>
							</span>
						</form>
						{% if settings.display_suggest_search %}
						{% include 'smart-search' %}
						{% endif %}
						<div class="header-tag hidden-sm hidden-xs">
							<b>Từ khóa phổ biến:</b> 
							{% assign search_list = settings.serch_list | split:"," %}
							{%for item in search_list%}
							<a href="/search?q={{item | url_escape}}">{{item}}</a>{%unless forloop.last%} / {%endunless%}
							{%endfor%}
						</div>
					</div>
					<div class="mobile-cart visible-sm visible-xs">
						<a href="javascript:void(0)" title="Giỏ hàng">
							<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" id="Layer_1" x="0px" y="0px" viewBox="0 0 469.333 469.333" style="enable-background:new 0 0 469.333 469.333;" xml:space="preserve" width="512px" height="512px"><g><g><g><path d="M434.979,42.667H85.333v3.061l-4.375-14.999C75.687,12.635,58.844,0,40,0H10.667C4.771,0,0,4.771,0,10.667     s4.771,10.667,10.667,10.667H40c9.427,0,17.844,6.313,20.479,15.365l66.396,227.635l-34.021,42.521     c-4.854,6.073-7.521,13.688-7.521,21.458c0,18.948,15.406,34.354,34.354,34.354H416c5.896,0,10.667-4.771,10.667-10.667     c0-5.896-4.771-10.667-10.667-10.667H119.687c-7.177,0-13.021-5.844-13.021-13.021c0-2.948,1.01-5.844,2.854-8.135l34.279-42.844     h209.221c16.448,0,31.604-9.615,38.615-24.5l74.438-158.177c2.135-4.552,3.26-9.604,3.26-14.615v-3.021     C469.333,58.073,453.927,42.667,434.979,42.667z M448,80.042c0,1.906-0.427,3.823-1.24,5.542L372.333,243.75     c-3.51,7.438-11.083,12.25-19.313,12.25H146.667L90.663,64h344.316C442.156,64,448,69.844,448,77.021V80.042z" fill="#222222"/><path d="M128,384c-23.531,0-42.667,19.135-42.667,42.667s19.135,42.667,42.667,42.667s42.667-19.135,42.667-42.667     S151.531,384,128,384z M128,448c-11.76,0-21.333-9.573-21.333-21.333c0-11.76,9.573-21.333,21.333-21.333     c11.76,0,21.333,9.573,21.333,21.333C149.333,438.427,139.76,448,128,448z" fill="#222222"/><path d="M384,384c-23.531,0-42.667,19.135-42.667,42.667s19.135,42.667,42.667,42.667s42.667-19.135,42.667-42.667     S407.531,384,384,384z M384,448c-11.76,0-21.333-9.573-21.333-21.333c0-11.76,9.573-21.333,21.333-21.333     c11.76,0,21.333,9.573,21.333,21.333C405.333,438.427,395.76,448,384,448z" fill="#222222"/></g></g></g><g></g><g></g><g></g><g></g><g></g><g></g><g></g><g></g><g></g><g></g><g></g><g></g><g></g><g></g><g></g></svg>
							<div class="cart-right">
								<span class="count_item_pr">{{ cart.item_count }}</span>
							</div>
						</a>
					</div>
				</div>
				<div class="col-md-4 hidden-sm hidden-xs">
					<div class="hotline">
						{% if settings.store_edit %}
						<a href="tel:{{ settings.store_phone| remove: ' ' }}" title="{{ settings.store_phone| remove: ' ' }}">{{ settings.store_phone }}</a>
						{% else %}
						<a href="tel:{{ store.phone_number | remove: ' '}}" title="{{ store.phone_number | remove: ' '}}">{{ store.phone_number }}</a>
						{% endif %}
						<span>{{ settings.store_text }}</span>
					</div>
					<div class="index-account">
					  {% if customer %}
						<!-- KHI ĐÃ ĐĂNG NHẬP -->
						<a href="/account" title="Tài khoản cá nhân">Tài khoản</a>
						<span class="user-name-title">
						  Xin chào, 
						  <strong>
							{% if customer.name != blank %}
							  {{ customer.name }}
							{% elsif customer.first_name != blank %}
							  {{ customer.first_name }}
							{% else %}
							  {{ customer.email | split: '@' | first }}
							{% endif %}
						  </strong>
						</span>
						<ul>
						  <li><a href="/account" title="Thông tin tài khoản"><i class="fa fa-user" style="margin-right:5px;"></i> Tài khoản của tôi</a></li>
						  <li><a href="/account/addresses" title="Sổ địa chỉ"><i class="fa fa-map-marker" style="margin-right:5px;"></i> Sổ địa chỉ</a></li>
						  <li><a href="/account/logout" title="Đăng xuất"><i class="fa fa-sign-out" style="margin-right:5px;"></i> Đăng xuất</a></li>
						</ul>
					  {% else %}
						<!-- KHI CHƯA ĐĂNG NHẬP (KHÁCH VÃNG LAI) -->
						<a href="/account/login" title="Tài khoản">Tài khoản</a>
						<span>Xin chào, Khách</span>
						<ul>
						  <li><a href="/account/login" title="Đăng nhập"><i class="fa fa-sign-in" style="margin-right:5px;"></i> Đăng nhập</a></li>
						  <li><a href="/account/register" title="Đăng ký"><i class="fa fa-user-plus" style="margin-right:5px;"></i> Đăng ký</a></li>
						</ul>
					  {% endif %}
					</div>
				
					<div class="index-cart">
						<a href="javascript:void(0)" title="Giỏ hàng"><i class="fa fa-shopping-bag"></i></a>
						<span class="cnt crl-bg count_item_pr">{{ cart.item_count }}</span>
					</div>
					
				</div>
			</div>
		</div>
	</div>
	<div class="main-navigation">
		<div class="container">
			{%include 'site-nav'%}
		</div>
	</div>
</header>


<script>
(function () {
    var header = document.querySelector('header.header');
    if (!header) return;

    var menu = header.querySelector(
        '.main-navigation .mainmenu'
    );

	var isHome = window.location.pathname === '/' || window.location.pathname === '/index';
	
    var previousScrollState = null;

    function updateHeaderState() {
        var isScrolled = window.pageYOffset > 20;

        /* Đổi màu header */
        header.classList.toggle('is-scrolled', isScrolled);

        if (!menu) return;

        /* Chỉ tự đóng/mở khi chuyển giữa đầu trang và trạng thái cuộn */
        if (previousScrollState !== isScrolled) {
            if (isScrolled || !isHome) {
                menu.classList.remove('is-open');
            } else {
                menu.classList.add('is-open');
            }

            previousScrollState = isScrolled;
        }
    }

    updateHeaderState();

    window.addEventListener('scroll', updateHeaderState, {
        passive: true
    });

    if (!menu) return;

    var line = menu.querySelector('.line');
    var title = menu.querySelector(':scope > span');

    /* Click tiêu đề để đóng/mở danh mục */
    function toggleMenu(event) {
        event.preventDefault();
        event.stopPropagation();
        menu.classList.toggle('is-open');
    }

    if (line) {
        line.addEventListener('click', toggleMenu);
    }

    if (title) {
        title.addEventListener('click', toggleMenu);
    }
})();
</script>
