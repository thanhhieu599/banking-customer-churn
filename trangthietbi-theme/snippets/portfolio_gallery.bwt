<div class="slide-owl-collection owl-carousel not-dqowl" id="collection-owl">{% if collection.description contains "<img" %}{% assign content-src = collection.description | split: 'src="' %}{% assign content-size = content-src.size | minus:1 %}{% for i in (1..content-size) %}{% assign src = content-src[i] | split: '"' | first | replace: '//cdn', 'http://cdn';;;; | replace: 'http:http://';;;;, 'http://';;;; | remove: 'https:' %}<div class="item"><img src="{{ src }}" alt="{{ page_title }}" /></div>{% endfor %}{% else %}{% endif %}</div>
