{% if settings.store_edit %}
	{% assign sb_phone = settings.store_phone %}
{% else %}
	{% assign sb_phone = store.phone_number %}
{% endif %}
{% assign sb_phone_raw = sb_phone | remove: ' ' | remove: '.' %}
{% assign sb_current = article.url %}

<div class="sb-wrap">

	{% if settings.blogs_aside_category_title %}
	<div class="bl-side-card">
		{% include 'aside-blog-category' %}
	</div>
	{% endif %}

	{% if settings.blogs_aside_recent_enable and blog.articles.size > 0 %}
	<div class="bl-side-card sb-recent">
		<h3 class="sb-heading">Bài viết mới nhất</h3>
		{% assign sb_count = 0 %}
		{% for post in blog.articles limit: 11 %}
		{% if post.url != sb_current and sb_count < 10 %}
		{% assign sb_count = sb_count | plus: 1 %}
		<a class="sb-post" href="{{ post.url }}" title="{{ post.title }}">
			<span class="sb-post-thumb">
				{% if post.image == null %}
				<img src="{{ 'no-image.jpg' | asset_url }}" alt="{{ post.title }}" />
				{% else %}
				<img src="{{ 'loaders.svg' | asset_url }}" data-lazyload="{{ post.image.src | img_url:'small' }}" alt="{{ post.title }}" />
				{% endif %}
			</span>
			<span class="sb-post-body">
				<span class="sb-post-title">{{ post.title }}</span>
				<span class="sb-post-date"><i class="fa fa-calendar-o" aria-hidden="true"></i> {{ post.created_on | date:'dd/MM/yyyy' }}</span>
			</span>
		</a>
		{% endif %}
		{% endfor %}
	</div>
	{% endif %}

	<div class="sb-cta">
		<h3>Cần tư vấn thiết bị bảo hộ?</h3>
		<p>Đội ngũ D&amp;T hỗ trợ lựa chọn và báo giá nhanh cho doanh nghiệp.</p>
		<a href="tel:{{ sb_phone_raw }}" class="sb-cta-btn sb-cta-primary"><i class="fa fa-phone" aria-hidden="true"></i> {{ sb_phone }}</a>
		<a href="/lien-he" class="sb-cta-btn sb-cta-ghost">Gửi yêu cầu báo giá</a>
	</div>

</div>

<style>
.sb-wrap { margin-bottom: 20px; }

/* ===== Thẻ chung ===== */
.bl-side-card {
	margin-bottom: 22px;
	padding: 22px 20px;
	background: #fff;
	border: 1px solid #eee;
	border-radius: 14px;
	box-shadow: 0 6px 20px rgba(0, 0, 0, .05);
}
.bl-side-card h2,
.bl-side-card h3,
.bl-side-card .title-head,
.bl-side-card .title_block,
.bl-side-card .aside-title,
.bl-side-card .title-module {
	margin: 0 0 14px !important;
	padding: 0 0 0 12px !important;
	border: 0 !important;
	border-left: 4px solid #bf2026 !important;
	background: none !important;
	font-size: 17px !important;
	font-weight: 700 !important;
	line-height: 1.3 !important;
	color: #222 !important;
	text-transform: none !important;
}
.bl-side-card ul { margin: 0; padding: 0; list-style: none; }
.bl-side-card li { padding: 9px 0; border-bottom: 1px dashed #eee; }
.bl-side-card li:last-child { border-bottom: 0; }
.bl-side-card a { color: #444; text-decoration: none; transition: color .2s; }
.bl-side-card a:hover { color: #bf2026; }

/* ===== Bài viết mới nhất ===== */
.sb-post {
	display: flex;
	gap: 12px;
	padding: 12px 0;
	border-bottom: 1px dashed #eee;
}
.sb-post:first-of-type { padding-top: 2px; }
.sb-post:last-child { padding-bottom: 0; border-bottom: 0; }
.sb-post-thumb {
	flex: 0 0 80px;
	width: 80px;
	height: 80px;
	overflow: hidden;
	border-radius: 8px;
	background: #f3f3f3;
}
.sb-post-thumb img {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform .4s;
}
.sb-post:hover .sb-post-thumb img { transform: scale(1.08); }
.sb-post-body { display: block; flex: 1; min-width: 0; }
.sb-post-title {
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
	margin-bottom: 6px;
	font-size: 14px;
	font-weight: 600;
	line-height: 1.45;
	color: #222;
}
.sb-post:hover .sb-post-title { color: #bf2026; }
.sb-post-date { display: block; font-size: 12px; color: #999; }
.sb-post-date .fa { margin-right: 4px; color: #bf2026; }

/* ===== Thẻ tư vấn ===== */
.sb-cta {
	padding: 24px 20px;
	border-radius: 14px;
	background: linear-gradient(135deg, #1f1f1f 0%, #3b1315 100%);
	color: #fff;
	text-align: center;
}
.sb-cta h3 {
	margin: 0 0 8px;
	font-size: 18px;
	font-weight: 700;
	line-height: 1.35;
	color: #fff;
	text-transform: none;
}
.sb-cta p {
	margin: 0 0 16px;
	font-size: 13px;
	line-height: 1.6;
	color: rgba(255, 255, 255, .8);
}
.sb-cta-btn {
	display: block;
	padding: 11px 14px;
	border-radius: 8px;
	font-size: 14px;
	font-weight: 600;
	text-decoration: none;
	transition: background .2s, color .2s;
}
.sb-cta-primary { margin-bottom: 10px; background: #bf2026; color: #fff; }
.sb-cta-primary:hover { background: #a01a20; color: #fff; }
.sb-cta-ghost { border: 1px solid rgba(255, 255, 255, .5); color: #fff; }
.sb-cta-ghost:hover { background: #fff; color: #1f1f1f; }

@media (max-width: 991px) {
	.sb-wrap { margin-top: 10px; }
}
</style>
