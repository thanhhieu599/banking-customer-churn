<script type="application/ld+json">
{
"@context": "http://schema.org",
"@type": "NewsArticle",
"mainEntityOfPage": {
"@type": "WebPage",
"@id": "https:{{store.url}}{{article.url}}"
},
"headline": "{{ article.title }}",
"datePublished": "{{ article.published_on }}",
"dateModified": "{{ article.created_on }}",
"description": "{{ article.summary | strip_html }}",
"author": {
"@type": "Organization",
"name": "{{store.name}}"
},
"publisher": {
"@type": "Organization",
"name": "{{store.name}}",
"logo": {
"@type": "ImageObject",
"url": "{{ 'logo.png' | asset_url }}",
"width": 300,
"height": 155
}
},
"image": {
"@type": "ImageObject",
"url": "{{ article.image.src }}",
"height": 600,
"width": 400
}
}
</script>
