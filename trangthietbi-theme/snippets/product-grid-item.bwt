{% assign sold_out = true %}
{% if product.available  %}
{% assign sold_out = false %}
{% assign awe-price = product.variants[0].price %}
{% assign awe-compare-price = product.variants[0].compare_at_price %}
{%else%}
{% assign awe-price = product.variants[0].price %}
{% assign awe-compare-price = product.variants[0].compare_at_price %}
{% endif %} 
{%assign contact = false%}
{%if awe-price == 0 %}
{%assign contact = true%}
{%endif%}
{% assign on_sale = false %}
{% if awe-price > 0 %}
{% if awe-compare-price > awe-price %}
{% assign on_sale = true %}
{% endif %}
{% endif %}
{% assign variantCount = product.variants | size %}
{% assign on_var = false %}
{% if variantCount > 1 %}
{% assign on_var = true %}
{% endif %}

{%if product.featured_image.alt ==""%}
{% assign featured_image_alt = product.name %}
{%else%}
{% assign featured_image_alt = product.featured_image.alt%}
{%endif%}

{% capture discount %} 
{{ product.selected_or_first_available_variant.compare_at_price | minus:product.selected_or_first_available_variant.price | times:100 | divided_by:product.selected_or_first_available_variant.compare_at_price | round }}% 
{% endcapture %}

{% comment %}
  === DỮ LIỆU THÊM (tạm thời lấy từ Tags của sản phẩm) ===
  Tag mẫu: ketthuc_2026-10-20  daban_229  danhgia_4.9  soluotdanhgia_3
{% endcomment %}
{% assign pcx_end = '' %}
{% assign pcx_sold = 0 %}
{% assign pcx_stars = 0 %}
{% assign pcx_reviews = 0 %}
{% for tag in product.tags %}
{% if tag contains 'ketthuc_' %}
{% assign pcx_end = tag | split: '_' | last %}
{% elsif tag contains 'daban_' %}
{% assign pcx_sold = tag | split: '_' | last %}
{% elsif tag contains 'soluotdanhgia_' %}
{% assign pcx_reviews = tag | split: '_' | last %}
{% elsif tag contains 'danhgia_' %}
{% assign pcx_stars = tag | split: '_' | last %}
{% endif %}
{% endfor %}
{% assign pcx_stars_num = pcx_stars | times: 1.0 %}

{% comment %}
  === ẨN SẢN PHẨM CHƯA ĐỦ THÔNG TIN MUỐN MUA (chỉ áp dụng ở trang chủ) ===
  Ẩn khi: có nhiều phiên bản (Chọn sản phẩm) / giá = 0 (Liên hệ) / hết hàng
  Muốn áp dụng cho mọi trang: xoá dòng {% if template == 'index' %} và {% endif %} tương ứng bên dưới.
{% endcomment %}
{% assign pcx_hide = false %}

{% unless pcx_hide %}
<div class="product-box">															
	<div class="product-thumbnail">
		{% assign on_sale = false %}
		{% if product.compare_at_price_min > product.price_min %}
		{% assign on_sale = true %}
		{% endif %}

		{% if on_sale %}
		<div class="sale-flash">{{ discount }}</div>
		{% endif %}	

		{% assign prefix = "ship" %}
		{% for tag in product.tags %}
		{% assign j = 0 %}
		{% if tag contains prefix %}
		{% assign j = j | plus: 1 %}
		{% assign suffix = tag | split: '_' | last %} 	
		<div class="va-product-tags"> 
			{{ suffix }}
		</div>
		{% endif %}
		{% endfor %}

		<div class="product-image-flip">
			<a href="{{ product.url }}" title="{{ product.name }}">
				{% if product.featured_image != null %}
				<img src="{{ 'loaders.svg' | asset_url }}" data-lazyload="{{ product.featured_image.src | img_url:'large' }}" alt="{{ product.name }}" class="img-responsive center-block" />
				{% else %}
				<img src="{{ 'no_image.jpg' | asset_url | img_url: 'medium' }}" alt="{{ product.name }}" class="img-responsive center-block" />
				{% endif %}
			</a>
		</div>
		
		<div class="prod-icons">
			<form action="/cart/add" method="post" class="variants form-nut-grid" data-id="product-actions-{{ product.id }}" enctype="multipart/form-data">
				{%if contact %}
				<a href="{{ product.url }}" data-toggle="tooltip" data-placement="bottom" class="fa fa-unlink" title="Chi tiết"></a>
				{% else %}
				{% if variantCount > 1 %}
				<a href="{{ product.url }}" data-toggle="tooltip" data-placement="bottom" class="fa fa-link" title="Chọn sản phẩm"></a>
				{% elsif sold_out %}
				<a href="{{ product.url }}" data-toggle="tooltip" data-placement="bottom" class="fa fa-unlink" title="Hết hàng"></a>
				{% else %}
				{%comment%}  
				<input type="hidden" name="variantId" value="{{ product.variants[0].id }}" />
				<a class="fa fa-shopping-basket add_to_cart" data-toggle="tooltip" data-placement="bottom" title="Mua ngay"></a>
				{%endcomment%}
				{% endif %}
				{% endif %}
				{% if settings.quickview_enable %}
				<a href="{{ product.url }}" data-handle="{{ product.alias }}" data-toggle="tooltip" data-placement="bottom" title="Xem nhanh" class="fa fa-search quick-view"></a>
				{% endif %}
			</form>
		</div>
		
	</div>
	<div class="product-info a-center">
		<h3 class="product-name"><a href="{{ product.url }}" title="{{ product.name }}">{{ product.name }}</a></h3>

		<div class="pcx-meta">
			<span class="pcx-badge{% if pcx_stars_num <= 0 %} pcx-badge--none{% endif %}" title="{{ pcx_reviews }} đánh giá"><span class="pcx-star">★</span>{{ pcx_stars }}</span>
			<span style = "margin-left:auto;text-align:right" class="pcx-sold" data-pid="{{ product.id }}">Đã bán: <b>{{ pcx_sold }}</b></span>
		</div>
		
		{%if contact %}
		<div class="price-box clearfix">
			<div class="special-price clearfix">
				<span class="price product-price">&nbsp;</span>
			</div>
		</div>
		{%else%}
		{% if on_sale %}
		<div class="price-box clearfix">
			<div class="special-price">
				<span class="price product-price">{{ awe-price | money }}</span>
			</div>
			<div class="old-price">
				<span class="price product-price-old">{{ awe-compare-price | money }}</span>
			</div>
		</div>
		{% else %}
		<div class="price-box clearfix">
			<div class="special-price">
				<span class="price product-price">{{ awe-price | money }}</span>
			</div>											
		</div>
		{% endif %}
		{% endif %}

		{% if pcx_end != '' and on_sale %}
		<div class="pcx-countdown" data-end="{{ pcx_end }}">
			<div><b data-d>0</b><span>Ngày</span></div>
			<div><b data-h>0</b><span>Giờ</span></div>
			<div><b data-m>0</b><span>Phút</span></div>
		</div>
		{% endif %}

		<div class="pcx-actions">
			{% if contact %}
			<a class="pcx-btn pcx-btn--contact" href="{{ product.url }}">Liên hệ</a>
			{% elsif variantCount > 1 %}
			<a class="pcx-btn" href="{{ product.url }}">Chọn sản phẩm</a>
			{% elsif sold_out %}
			<a class="pcx-btn pcx-btn--out" href="{{ product.url }}">Hết hàng</a>
			{% else %}
			<form action="/cart/add" method="post" class="pcx-form" enctype="multipart/form-data">
				<input type="hidden" name="variantId" value="{{ product.variants[0].id }}" />
				<div class="pcx-qty">
					<button type="button" data-pcx-minus>−</button>
					<input type="number" name="quantity" value="1" min="1" />
					<button type="button" data-pcx-plus>+</button>
				</div>
				<button type="submit" class="pcx-btn">Thêm vào giỏ hàng</button>
			</form>
			{% endif %}
		</div>
	</div>
</div>
{% endunless %}
