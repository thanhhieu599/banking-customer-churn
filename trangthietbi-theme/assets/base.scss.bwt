$font-nav:  "HelveticaNeue","Helvetica Neue",Helvetica,Arial,sans-serif;
$baseFontSize: {{ settings.type_base_size }};
$headingFontSize: {{settings.type_header_size}};
$navFontSize: 14px;
$text-color: {{ settings.color_body_text }};
$link-color: {{ settings.color_primary }};
$disabledGrey: #ddd;
$disabledBorder: #ddd;
@function em($pixels, $context: $baseFontSize) {
	@if (unitless($pixels)) {
		$pixels: $pixels * 1px;
	}
	@if (unitless($context)) {
		$context: $context * 1px;
	}
	@return $pixels / $context * 1em;
}
@function emh($pixels, $context: $baseFontSize) {
	@if (unitless($pixels)) {
		$pixels: $pixels * 1px;
	}
	@if (unitless($context)) {
		$context: $context * 1px;
	}
	@return $pixels / $context * 1em;
}
@function emn($pixels, $context: $navFontSize) {
	@if (unitless($pixels)) {
		$pixels: $pixels * 1px;
	}
	@if (unitless($context)) {
		$context: $context * 1px;
	}
	@return $pixels / $context * 1em;
}


/*Slider*/
.home-slider, .section-blog-sliders{
	overflow:hidden;
	.item{
		position: relative;		
	}
	&.owl-carousel .owl-nav {
		@mixin owl{

		}
		.owl-next{
			right: 15px!important;		
			background: transparent;
			top: 50%;
		}
		.owl-prev{
			left: 15px!important;	
			background: transparent;
			top: 50%;
		}
	}
	&.owl-carousel{
		.owl-nav {
			.owl-prev:before, .owl-next:before {
				font-size: 20px;
				background: #fff;
				border: 1px solid #222;
				color: #222;
				height: 35px;
				width: 35px;
				text-align:center;
				line-height: 32px;
				border-radius: 50%;
			}
			.owl-prev, .owl-next{
				&:hover{
					&:before{
						color: $main-color;
						border-color: $main-color;
					}
				}
			}
		}
		.owl-dots{
			.owl-dot{
				&.active{
					width: 30px;
					height: 10px;
					background-color: #222;
					border-radius: 6px;
				}
				height: 10px;
				width: 10px;
				background-color: rgba(0, 0, 0, 0.2);
			}
		}
	}
}
.section-blog-sliders{
	&.owl-carousel{
		.owl-dots{
			.owl-dot{
				&.active{
					background-color: #a8a8a8;
				}
			}
		}
	}
}

/*Tab products*/
.section_tab_product{
	h2{
		font-size: em(25px);
		line-height: 1.1;
		margin: 0 0 20px 0;
		color: #222;
	}
	.tabs-title{
		margin-bottom: 30px;
		border-radius: 0px;
		overflow: hidden;
		margin-top: 10px;
		li{			
			display: inline-block;
			background: #fff;
			height: 20px;
			line-height: 20px;
			margin: 0 10px;
			font-size: 14px;
			text-transform: uppercase;
			position: relative;
			color: #8c8c8c;
			&.current{
				color: #333;
				background: #fff;
			}
			&:hover, &:focus{
				color: #333;
			}
		}
	}	
	.tab-content{
		clear: left;
		.products{
		}
	}
}

@media(max-width: 767px){
	.section_tab_product .tabs-title li {
		width: 87px;
	}
}
/*Blogs*/
.section-news{
	h2{

		a{
			color: #222;
			&:hover, &:focus{
				color: $main-color;
				text-decoration:none;
			}
		}
	}
	.blog-item{
		background: #fff;
	}		
}
