/*============================================================================
1. Mixin
==============================================================================*/
@mixin clearfix() {
	&:after {
		content: "";
		display: table;
		clear: both; }
	*zoom: 1;
}
@mixin transition($args...) {
	-webkit-transition: $args;
	-moz-transition: $args;
	-ms-transition: $args;
	-o-transition: $args;
	transition: $args;
}
@mixin transform($transforms) {
	-moz-transform: $transforms;
	-o-transform: $transforms;
	-ms-transform: $transforms;
	-webkit-transform: $transforms;
	transform: $transforms;
}
// rotate
@mixin rotate ($deg) {
	@include transform(rotate(#{$deg}deg));
}

// scale
@mixin scale($scale) {
	@include transform(scale($scale));
} 
// translate
@mixin translate ($x, $y) {
	@include transform(translate($x, $y));
}
// skew
@mixin skew ($x, $y) {
	@include transform(skew(#{$x}deg, #{$y}deg));
}
//transform origin
@mixin transform-origin ($origin) {
	moz-transform-origin: $origin;
	-o-transform-origin: $origin;
	-ms-transform-origin: $origin;
	-webkit-transform-origin: $origin;
	transform-origin: $origin;
}

@mixin prefix($property, $value) {
	-webkit-#{$property}: #{$value};
	-moz-#{$property}: #{$value};
	-ms-#{$property}: #{$value};
	-o-#{$property}: #{$value};
	#{$property}: #{$value};
}
@mixin gradient($from, $to, $fallback) {
	background: $fallback;
	background: -moz-linear-gradient(top, $from 0%, $to 100%);
	background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,$from), color-stop(100%,$to));
	background: -webkit-linear-gradient(top, $from 0%, $to 100%);
	background: -o-linear-gradient(top, $from 0%, $to 100%);
	background: -ms-linear-gradient(top, $from 0%, $to 100%);
	background: linear-gradient(top bottom, $from 0%, $to 100%);
}
@mixin backface($visibility: hidden) {
	@include prefix('backface-visibility', #{$visibility});
}
@mixin box-sizing($box-sizing: border-box) {
	-webkit-box-sizing: #{$box-sizing};
	-moz-box-sizing: #{$box-sizing};
	box-sizing: #{$box-sizing};
}
@mixin border-radius($radius) {
	-webkit-border-radius: $radius;
	border-radius: $radius;
}
/*============================================================================
2. Variable
==============================================================================*/
$gutter: 30px;
$main-color: {{ settings.color_main }};
$border-color: {{ settings.color_borders }};
$font-base:  {{ base_family }};
$font-header:  {{ header_family }};
$font-accent:  {{ accent_family }};
$baseFontSize: {{ settings.type_base_size }};
$text-color: {{ settings.color_body_text }};
$header-bg-color: {{ settings.color_body_text }};
$footer-bg-color: {{ settings.color_body_text }};
$disabledGrey: #ddd;
$disabledBorder: #ddd;

/*============================================================================
#Function
==============================================================================*/
@function em($pixels, $context: $baseFontSize) {
	@if (unitless($pixels)) {
		$pixels: $pixels * 1px;
	}
	@if (unitless($context)) {
		$context: $context * 1px;
	}
	@return $pixels / $context * 1em;
}

/*============================================================================
3. Element
==============================================================================*/
/*3.1 Title*/
.title-head {
	font-size: em(20px);
	font-weight: 700; 
	color: $text-color;	
	text-decoration: none;
	a{
		color: $text-color;
		&:hover{
			color: $main-color;
		}
	}
}
.subtitle-head{
	font-size:em(18px);
	color: $text-color;
	margin: 20px 0;
}
/*3.2 Product item*/
.product-box {
	text-align: left;
	margin-bottom: 30px;
	background: #fff;
	position: relative;	
	overflow:hidden;
	&:before {
		content: "";
		width: 100%;
		height: 100%;
		background: rgba(255, 255, 255, 1);
		position: absolute;
		top: 0;
		left: 0;
	}
	.product-thumbnail {
		position: relative;  
		overflow: hidden;
		img{
			-webkit-transition-property: background-image;
			-webkit-transition-duration: 1.0s;
			-webkit-transition-timing-function: ease-out;
			transition-property: background-image;
			transition-duration: 1.0s;
			transition-timing-function: ease-out;
			transition: all 700ms ease 0s;
		}
	}
	.product-info {
		z-index: 1;
		position: relative;
		padding-bottom: 10px;
		padding-left: 5px;
		padding-right: 5px;
	}
	.product-name {
		font-size: em(14px);
		line-height: 24px;
		color:#333;		
		font-weight: 500;
		margin-top: 10px;
		margin-bottom: 5px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		a {
			color: #222;
			text-decoration: none;
			&:hover {
				color: $main-color;
			}
		}
	}	
	.special-price{
		display: inline-block;
		.product-price {
			color: #d0021b;
			font-size: em(14px);
			line-height: em(24px);
			display: inline-block;
			font-weight: 600;

		}
	}
	.old-price{
		display: inline-block;
		.product-price-old {
			text-decoration: line-through;
			font-size: em(12px);
			margin: 0 0 0 5px;
			display: inline-block;
			color: #666;
		}
	}
	.sale-flash {
		z-index: 9;
	}
	.product-summary {
		font-size: em(14px);
		color: #acacac;
		line-height: 20px;
	}
	form{		
		@include scale(1);
	}
	&:hover{
		.product-thumbnail{
			img{
				-webkit-transform: scale(1.1);
				-khtml-transform: scale(1.1);
				-moz-transform: scale(1.1);
				-ms-transform: scale(1.1);
				-o-transform: scale(1.1);
				transform: scale(1.1);
			}
		}
	}
}
.product-price {
	color: #323c3f;
	font-size: em(20px);
	line-height: 24px;
	display: block;
	font-weight: 700; 
}
.products-view-list {
	.product-box {
		.product-thumbnail {
			text-align: center;
			margin-bottom: 0;
			width: calc(100% / 3);
			float: left
		}
		.product-info {
			text-align: left;
			margin-left: 30px;
			float: left;
			width: calc(100% / 3 * 2 - 30px);
			background: transparent;
			border-top: none;
		}
	}

}
/*3.3 Breadcrumb*/
.breadcrumb {
	margin: 0;
	font-size: em(12px);
	padding: 10px 0;
	background-color: #fff;
	border-radius: 0; 
	li {
		display: inline;
		> a {
			color: #222;
			> span {
				color: #222;
				&:hover, &:focus{
					color: $main-color;
					text-decoration:none;
				}
			}
			&:hover, &:focus{
				color: $main-color;
				text-decoration:none;
			}
		}
		span {
			display: inline;
			color: #323c3f;
			.fa {
				color: #323c3f;
			}
		}
		a:hover, &.active, strong {
			color: $main-color;
			font-weight: 400;
		}
	}
	>li+li:before{
		display: none;
	}
}
/*3.4 Pagination*/
.pagination {
	margin-bottom: 20px;
	.page-link {
		float: left;
		margin: 0 2.5px;
		width: 28px;
		background: transparent;
		text-align: center;
		height: 28px;
		font-size: 14px;
		line-height:28px;		
		color: #555555;
		border-radius: 0;
		border: none;
		text-decoration: none;
		border-radius: 50% !important;
		padding: 0;
		&:hover {
			background-color: #fff;
			border-color:  #fff;
			color: $main-color;
		}
	}
	.page-item {
		&.disabled .page-link {
			border: 0;
			background: transparent;
			color: #555555;
		}
		&.active .page-link {
			background-color: #fff;
			border-color:  #fff;
			color: $main-color;
		}
	}
}


/*============================================================================
4. Header
==============================================================================*/
$header-bg: {{settings.color_header_bg}};
$topbar: {{settings.color_header_topbar_bg}};
/*4.1  Header Gerenal*/
header{
	background:$header-bg;
}
.topbar {
	background:$topbar;
}
.header-main{
	padding: 30px 0;
}
.logo {
	display: inline-block;
	font-size: em(40px);
}
.header_search {
	padding: 10px 0 15px;   
	input{
		float: right;
	}
	.input-group-btn{
		position: absolute;
		right: 0;
		top: 0;		
		width: 45px;
	}
	.input-group{
		width: 100%;
		margin-bottom: 0;
	}	
	button{
		padding: 0;
		width: 45px;   
		background: transparent;
		img{
			margin-top: 6px;
		}
	}
}

/*4.2  Minicart*/
.mini-cart {		
	z-index: 10;	
	text-align: center;

	&:hover .top-cart-content {
		display: block;
	}
	.dropdown-toggle {
		font-size: 12px;
		padding: 0;
		text-transform: none;
	}	
}

.top-cart-contain {
	color: #333;  
	padding: 0;
	right: 0;
	z-index: 1000;
	.price {
		color: $main-color;
		text-transform: uppercase;
	}
	.mini-cart .price {
		margin-right: 5px;
		font-size: 16px;
		font-weight: 700;
	}
	.product-details .price {
		color: $main-color;
		width: auto;
		float: none;
		font-weight: 400;
		padding-left: 0;
		font-size: 12px;
	}
}

.top-cart-content {

	display: none;
	position: absolute;
	top: 30px;
	right: 0;
	background: #fff;
	padding: 0;
	text-align: left;
	box-shadow: 0 0 15px -5px rgba(0, 0, 0, 0.4);
	z-index: 10000;
	.empty {
		text-align: left;
		color: #333;
	}
	.product-name {
		margin: 0;
		width: 150px;
		line-height: 1;		
		padding-right: 10px;
		white-space: nowrap;
		text-overflow: ellipsis;
		overflow: hidden;
		a {
			font-size: em(14px);
			line-height: normal;
			line-height: 20px !important;
			font-weight: 400;
			color: #333;
		}
	}
	li {
		list-style: none;
		&.item {
			border-top: 1px solid #eee;
			overflow: hidden;
			padding: 20px 0;
			&:first-child {
				border-top: none;
				padding-top: 10px;
			}
			&:last-child {
				margin: 0;
				border-bottom: none;
			}
			.product-image{
				float: left;
				display: block;
				width: 100px;
				margin-right: 10px;
			}
			.detail-item{
				padding-left: 110px;
				.fa{
					position: absolute;
					right: 20px;
				}
				input{
					display: inline-block;
					width: 45px;
					padding: 0;
					text-align: center;
				}
				button.items-count {
					display: inline-block;
				}
			}
		}
	}
	.block-subtitle {
		color: #333;
		overflow: hidden;
		padding: 15px;
		text-align: left;
		font-family: 'Open Sans', sans-serif;
		font-size: em(13px);
		background: #f5f5f5;
		text-transform: none;
		font-weight: 400;
		border-bottom: 1px #ddd solid;
	}
}

.top-subtotal {
	color: #333;
	font-size: em(16px);
	font-weight: 400;
	padding: 12px 0;
	padding-top: 30px;
	text-align: left;
	text-transform: none;
	.price {
		font-weight: 700;
		color: $main-color;
		float: right;
	}
}

ul#cart-sidebar {
	padding: 20px 30px;
	margin: 0;
	max-height: 582px;
	min-width: 320px;
	li {
		&.list-item {
			max-height: 400px;
			overflow-y: auto;
		}
		&.action {
			display: none;
		}
	}
	&.hasclass li.action {
		display: block;
	}
	li.list-item {
		.price2 {
			font-weight: 700;
			color: #f94e3f;
			font-size: 14px;
			display: list-item;
			margin-bottom: 5px;
		}
		&::-webkit-scrollbar {
			width: 5px;
		}
		&::-webkit-scrollbar-track {
			background: rgba(255, 255, 255, 0.9);
		}
		&::-webkit-scrollbar-thumb {
			background: $main-color;
			border-radius: 15px;
			&:hover, &:active {
				background: $main-color;
				border-radius: 15px;
			}
		}
	}
}

.li-fix-1 {
	background: #FFF;
	border-top: 1px solid #ebebeb;
	display: block;
}

.li-fix-2 {
	display: block;
	width: 295px;
}
/*4.3 Menu*/
$nav: {{settings.color_nav_bg}};
header nav {
	background: $nav;	
	.nav{
		position: relative;
	}
	.nav-item {
		float: left;		
		position: relative;
		margin-right: 10px;
		&.has-mega{
			position: static;
		}
		>a{
			color: #333;
			padding: 10px;
			&:hover, &:focus{
				color: #4a90e2;
				background-color: transparent;
			}
		}
		>.fa{
			color: #fff;
			position: absolute;
			right: 0;
			top: 33px;
		}
		.nav-item-lv2 {
			padding: 0 10px;
		}
		.nav-item-lv3 {
			padding: 0 10px;
		}
		&:hover{
			>.dropdown-menu{
				display: block;
				margin-top: 0;
				padding: 0;
				min-width: 200px;
				border-radius: 0;
				li{
					padding: 0 3px;
					a{
						padding: 3px 0;
						&:hover, &:focus{
							background-color: transparent;
							color: $main-color;
						}
					}
				}
			}
			> .mega-content{
				display: block;
				&:before {
					display: block;
				}
			}
		}
		li.dropdown-submenu {
			position: relative;

			.dropdown-menu{
				left: 100%;
				top: 0;
			}
			&:hover{
				>.dropdown-menu{
					display: block;
					margin: 0;
					border-radius: 0;
					padding: 0;
					min-width: 200px;
					top: -1px;
				}
			}
		}
	}
	.mega-content {
		display: none;
		position: absolute;
		width: 100%;
		background: #fff;
		z-index: 100;
		padding: 20px;
		border: 1px solid #fff;
		left:0;
		top: 45px;
		-webkit-box-shadow: 0 6px 15px rgba(0,0,0,.12);
		box-shadow: 0 6px 15px rgba(0,0,0,.12);
		&:before {
			content: "";
			position: absolute;
			left: 0px;
			top: -10px;
			width: 100%;
			height: 20px;
			background: 0 0;
			display: inline-block;
		}
		.level1.item {
			float: left;
			width: 25%;
			padding: 0 5px;
			h2{
				font-size: 12px;
				font-weight: 600;
				text-transform: uppercase;
				a{
					color: $main-color;
					&:hover, &:focus{
						color: darken($main-color, 10);
					}
				}
			}
			ul{
				li{
					a{
						display: block;
					}
				}
			}
		}
		.level0-wrapper2{
			.nav-block{
				.level0{
					display: -ms-flexbox;
					display: -webkit-flex;
					display: flex;
					-webkit-flex-wrap: wrap;
					-ms-flex-wrap: wrap;
					flex-wrap: wrap;
				}
			}
		}
	}

}


/*============================================================================
5. FOOTER
==============================================================================*/
$footer-bg: {{settings.color_footer_bg}};
$footer-title: {{settings.color_footer_title}};
$footer-link: {{settings.color_footer_link}};
$footer-border: {{settings.color_footer_border}};
$footer-icon: {{settings.color_footer_icon}};
$footer-subcribe: {{settings.color_footer_sub_info}};
$footer-copyright: {{settings.color_footer_copyright}};
footer{	
	background:$footer-bg;
	position: relative;
	overflow: hidden;
	.footer-info-widget{
		h3{
			font-size: em(18px);
			color: $footer-title;
			text-transform:uppercase;   
			margin-bottom: 20px;
		}
		p{
			color: $footer-subcribe;
			font-size: em(16);
			&.hotline{
				font-size: em(28px);
				color: $footer-icon;        
				font-weight: 700;
				margin-bottom: 15px;
				margin-top: -8px;
				a{
					color: $footer-icon; 
					&:hover{
						color: $main-color;
					}
				}
			}
		}
		form{
			position: relative;
			input{
				height: 50px;
				@include border-radius(5px);
				font-size: em(16px);
			}
			button{
				position: absolute;
				right: 0;
				background: transparent;
				border: none;
				line-height: 50px;
				font-size: em(30px);
				color: #a6a6ad;
				padding-right: 10px;
			}
		}
	}
	.list-inline{
		.fa{
			color: $footer-icon;
			margin-right: 20px;
			font-size: em(30);
			&:hover{
				color:$main-color;        
			}
		}
	}
	.site-footer{
		h3, h4{
			position: relative;
			color: $footer-title;
			margin: 0;
			padding: 13px 0;    
			font-size: em(18px);

		}
	}

	.list-menu{		
		margin-bottom: 15px;
		line-height: em(24px);
		a{
			color: $footer-link;     
			&:hover{
				color:$main-color;
			}
		}
		li{
			color: $footer-link;
		}
		&.contact .fa {
			width: 20px;
			margin-right: 5px;
			color:$main-color;
		}
	} 
	.copyright {
		width: 100%;
		overflow: hidden;
		background: #f8f8f8;
		padding: 10px 0;
		color: #999;
		text-align:center;
		font-size: 12px;
		font-weight: normal;
		b{
			font-weight: normal;	
		}
		a{      
			color: #999;
			&:hover{
				color: #288ad6;
			}
		}
	}
	.social-icons li{
		margin-right: 10px;
	}
	.back-to-top {
		position: absolute;
		right: 10px;
		bottom: 10px;
		font-size: 20px;
		color: $text-color;
		line-height: 1;
		cursor: pointer;
		background-color: #fff;
		border-radius: 50%;
		border: 1px solid #333;
		height: 35px;
		width: 35px;
		text-align:center;
		line-height: 33px;
		&.show {
			position: fixed;
			right: 10px;
			bottom: 165px;
			z-index: 9999;
			top: auto !important;
		}
		&:hover{
			background-color: $main-color;
			border-color: $main-color;
			color: #fff;
		}
	}
	form{
		position: relative;
		button#subscribe {
			position: absolute;
			right: 0;
		}
	}

}

/*============================================================================
6. Product detail
==============================================================================*/
.details-product{
	#gallery_01 {
		margin-top: 15px;
	}
	.owl-carousel.owl-loaded{
		overflow: hidden;
	}
	.details-pro{
		.product-price{
			font-size: em(30px);
			display: inline-block;
		}
		.price-box{
			margin: 10px 0 15px;
			del{
				color: #adadad;
				font-size: em(20px);
			}
		}
		.custom-btn-number {
			position: relative;
			padding: 0;
			margin-bottom: 20px;
			border: none;
			box-shadow: none;	
			height: auto;
			label{font-size: 14px;}
			#qty {			
				height:40px;
				font-size: em(14px);			
				margin:0;
				width: 60px;
				padding: 0 2px;
				text-align: center;
			}
			.qtyminus {
				position: absolute;
				left: 25px;
				top: 4px;
				font-size: em(20px);
			}
			.qtyplus {
				position: absolute;
				right: 25px;
				top: 4px;
				font-size: em(20px);
			}
		}	
	}
}
.zoomWrapper {
	width: 100%!important;
	height: auto!important;
}
.zoomWrapper img {
	position: static!important;
	max-width: 100%!important;
	height: auto!important;
	& ~ img{
		display: none!important;
	}
}
.product-tab{
	.tab-link{
		margin-right: 20px;
		h3{
			margin: 10px 0;
			font-size:em(16px);
		}
		span{

			font-size:em(16px);
		}
		&.current{
			h3{
				color: $main-color;
			}
		}
	}
	.tab-content.current{
		padding: 10px;
		border: 1px solid $border-color;
		min-height: 200px;
	}
}
/*============================================================================
7. Collection
==============================================================================*/
.view-mode span{
	font-size: 0;
}
.button-view-mode{
	padding: 0;
	margin: 0;
	font-size: em(20px);
	&.active{
		box-shadow: none;
		color: $text-color;
		a{
			color: $text-color;
		}
	}	
}
.sortPagiBar{
	border-bottom: 1px solid #e1e1e1;
	margin-bottom: 20px;
	padding-bottom: 15px;
}
/*============================================================================
8. Blogs
==============================================================================*/
.blog-item {  	
	overflow: hidden;
	margin-bottom: 15px;
	.date {
		position: absolute;
		background: $main-color;
		text-align: center;
		color: #fff;
		padding: 3px 10px;
		z-index: 10;
		span{
			display: block;
			line-height: 45px;
			& ~ span{       
				overflow: hidden;
				border-top: 1px solid #fff;
			}
		}
	}
}
.blog-item-name {	
	font-weight: 700;
	position: relative;
	font-size:em(16px);
	margin:0;
	a{
		color: $text-color;
	}
	.fa{
		position: absolute;
		left: 0;
		top: 9px;
		font-size: 11px;
		color: $main-color;
	}
}
.blog-item-summary {
	font-size:em(14px);
	margin-bottom: 0;
}
.blog-item-thumbnail {
	position: relative;
}
.list-blogs {
	.blog-item {
		margin-bottom: 25px;		
	}
}
/*============================================================================
9. Article
==============================================================================*/
.article-main{
	.article-title {
		font-size: em(24px);
		line-height: em(27px);
		margin: 15px 0 8px;
	}
	.postby {
		font-size: em(16px);
		line-height: em(24px);
		color: #676767;
		margin-bottom: 10px;
	}
	.article-content {
		font-size: em(14px);
	}
	.form-group {
		margin: 0;
		padding-top: 0;
		padding-bottom: 8px;
	}
}

#article-comments{
	margin-top: 30px;
	.article-comment {
		margin-bottom: 10px;
	}
	.article-comment-user-image {
		margin: 0;
		float: left;
		width: 50px;
		margin-right: 12px;
	}
	.article-comment-user-comment {
		padding-left: 63px;
		font-size: em(14px);


	}
	.user-name-comment {
		margin: 0;
		color: $main-color;
		font-size: 18px;
		line-height: 1;
	}
	.article-comment-date-bull {
		padding: 5px 0;
		display: block;
		color: #acacac;
		font-size: 12px;
	}
}
.social-media{
	font-size: em(14px);
	label{
		display: inline-block;
	}
	a{
		margin-right: 7px;
		color: #222;
		&:hover, &:focus{
			text-decoration:none;
			color: #222;
			.fa-facebook-official{
				color: #3b5998;
			}
			.fa-twitter{
				color: #1da1f2;
			}
			.fa-pinterest{
				color: #bd081c;
			}
			.fa-google-plus{
				color: #dd4b39;
			}
		}
	}
	.list-inline li{
		margin-right: 20px;
	}
}
textarea{
	&.form-control{
		border: 1px solid #e1e1e1;
	}
}
.section-news-2{
	margin-bottom: 20px;
}
/*============================================================================
10. CART
==============================================================================*/
.cart-item{
	background: #fff;
	padding: 20px 10px;
	border-bottom: 1px solid $border-color;

}
.cart-item-image {
	float: left;
	width: 120px;
	margin-right: 20px;
}
.cart-item-info {
	padding-left: 140px;
	h3{
		margin: 0;
		font-size: em(18px);
		font-weight: 400;
	}
	.product-price{
		line-height: 50px;
	}
	input{
		width: 95px;
		height: 45px;
		border-color: $border-color;
		float: left;
	}
	.remove-item {
		color: #c6c6c6;
		font-size: 38px;
		font-weight: 300;
		line-height: 47px;
		float: right;
	}
	.variant{
		color: #adadad;
	}
}
.name-product-cart{
	color: $main-color;
}
.cart{
	.total-price{
		background: #fff;
		padding: 25px;
		line-height: 45px;
	}
}
.delete-cart{
	.title{
		font-size: em(30px);
		text-align: center;
		padding: 30px 10px;
	}
	.btn-50{
		width: calc(50% - 3px);
		a{
			color: #fff;
			display: block;
		}
	}
}

/*============================================================================
11. ACCOUNT,ORDER,ADDREDSS...
==============================================================================*/
/*11.1 Account gerenal*/
#customer_register{
	margin-bottom: 20px;
}
#customer_login,
#recover_customer_password{
	margin-bottom: 0;
}
.checkbox.style {
	input {
		margin: 0 !important;
		display: none;
	}
	label {
		display: inline-block;
		vertical-align: middle;
		font-weight: normal;
		text-transform: none;   
		position: relative;
		padding-left: 55px;
		line-height: 50px;
		&:before {
			display: block;
			width: 35px;
			height: 35px;
			background: #fff;
			border: 1px solid #d4d4d4;
			border-radius: 5px;
			content: "";
			position: absolute;
			left: 0;
			top: 50%;
			transform: translateY(-50%);
			-moz-transform: translateY(-50%);
			-ms-transform: translateY(-50%);
			-webkit-transform: translateY(-50%);
			-o-transform: translateY(-50%);
		}
	}
	input:checked + label:after {
		content: "\f00c";
		font-family: FontAwesome;
		font-size: 20px;
		color: $main-color;
		position: absolute;
		top: 50%;
		left: 8px;
		transform: translateY(-50%);
		-moz-transform: translateY(-50%);
		-ms-transform: translateY(-50%);
		-webkit-transform: translateY(-50%);
		-o-transform: translateY(-50%);
	}
}


/*11.2 Account*/
.block-account{
	h3{
		margin-top: 0;
	}
}
.customer-name{
	color: $main-color;
	line-height: 55px;
}
.block-content.form-signup{
	background: #fff;
	padding-top: 10px;
	p{
		padding: 0;
		display: table;
		i{
			display: table-cell;
			width: 20px;
			text-align: center;
			color: $main-color;
		}
	}
}
.address-title{
	padding-left: 10px;
	margin-bottom: 15px;
	border-radius: 0!important;
	font-weight: 300;
	button{
		background: none;
		border: none;
		font-size: 0;
		width: 50px;
		height: 55px;
		&.btn-edit{
			background-image:url({{ 'btn-edit.png'|asset_url}});
			background-repeat: no-repeat;
			background-position: center;
		}
		&.btn-delete{
			background-image:url({{ 'btn-delete.png'|asset_url}});
			background-repeat: no-repeat;
			background-position: center;
		}
	}
}
.address-subtitle{
	margin-top: 0;
	text-transform: uppercase;
}
.address-item-action{
	right: 0;
	top: -7px;
	.btn-row{
		padding-right: 5px;
	}
}
.address-group {
	background: #fff;
	padding-bottom: 5px;
	margin-bottom: 15px;
	p{		
		color: #595959;
		label{
			float: left;
			font-weight: 300;
		}		
	}
}

/*11.2 Order*/
#order_payment,
#order_shipping{
	background: #fff;
	padding:10px 0;
	.address.note{
		i{
			color: $main-color;
			margin-right: 5px;
		}
	}
}
.totalorders {
	background: #fff;
	border-color: $border-color;
}
.order-headding{
	margin:0;
}

.info-contact{
	.widget-menu{
		p{
			display: inline;
		}
	}
	.logo{
		font-size: 20px;
	}
}
/*============================================================================
12. SIDEBAR
==============================================================================*/
.aside-item{
	&.collection-category{
		.nav-item {
			position: relative;
			clear: left;
			font-size: em(15px);
			a{
				font-size: em(15px);
			}
			.fa{
				position: absolute;
				right: 0;
				top: 12px;
			}
			.dropdown-menu{
				position: static;
				width: 100%;
				border: 0;
				padding-left: 15px;
				box-shadow: none;
			}
			&.active{
				>a{
					color: $main-color;
				}
				>.dropdown-menu{
					display: block;
				}
			}
		}
		.nav>li>a {
			padding: 5px 15px;
		}
	}
	.nav>li>a:focus, .nav>li>a:hover{
		background: none;
	}
}
.ui-widget.ui-widget-content{
	height: 2px;
	background: #ebebeb;
}
.ui-slider-range.ui-corner-all.ui-widget-header {
	background: $main-color !important;
}
.ui-slider-horizontal .ui-slider-handle {
	height: 14px!important;
	width: 14px!important;
	border-radius: 50%!important;
	top: -6px!important;
	border: none!important;
	background: $main-color!important;
}
.ui-widget.ui-widget-content {
	border: none!important;
	margin-bottom: 25px;
	width: calc(100% - 14px);
	margin-left: 7px;
}
#start{
	width: 100px;
	float: left;
	@media(max-width: 1024px){
		width: 80px;
	}
	input{
		text-align: center;
		border-radius: 0px;
		border: 1px solid #e1e1e1;
		box-shadow: none;
		outline: none;
		box-shadow: none;
		-webkit-appearance: none;
		-moz-appearance: none;
	}
}
#stop{
	width: 100px;
	float: left;
	margin-left: 30px;
	text-align: center;	
	position: relative;
	@media(max-width: 1024px){
		width: 80px;
	}
	input{
		text-align: center;
		border-radius: 0px;
		border: 1px solid #e1e1e1;
		box-shadow: none;
		outline: none;
		box-shadow: none;
		-webkit-appearance: none;
		-moz-appearance: none;
	}
	&:before {
		content: "-";
		position: absolute;
		left: -17px;
		font-size: 17px;
	}
}
a#filter-value {
	height: 30px;
	line-height: 30px;
	font-weight: 400;
	width: 100px;
	margin-top: 15px;
	background-color: $main-color;
	color: #fff;
	border-color: $main-color;
	&:hover, &:focus{
		outline: none;
		box-shadow: none;
		-webkit-appearance: none;
		-moz-appearance: none;
		background-color: darken($main-color, 20%);
		border-color: darken($main-color, 20%);
	}
}
/*============================================================================
#13. FIXED APPS
==============================================================================*/
div#isp_search_result_page_container .btn-search {
	display: none;
}
button.btn.btn-default.btn-search {
	display: none;
}
div#isp_search_result_page_container form{
	margin-bottom: 0;
}

/*============================================================================
#Mixin
==============================================================================*/
@mixin clearfix() {
	&:after {
		content: "";
		display: table;
		clear: both; }
	*zoom: 1;
}
@mixin transition($args...) {
	-webkit-transition: $args;
	-moz-transition: $args;
	-ms-transition: $args;
	-o-transition: $args;
	transition: $args;
}
@mixin transform($transforms) {
	-moz-transform: $transforms;
	-o-transform: $transforms;
	-ms-transform: $transforms;
	-webkit-transform: $transforms;
	transform: $transforms;
}
// rotate
@mixin rotate ($deg) {
	@include transform(rotate(#{$deg}deg));
}

// scale
@mixin scale($scale) {
	@include transform(scale($scale));
} 
// translate
@mixin translate ($x, $y) {
	@include transform(translate($x, $y));
}
// skew
@mixin skew ($x, $y) {
	@include transform(skew(#{$x}deg, #{$y}deg));
}
//transform origin
@mixin transform-origin ($origin) {
	moz-transform-origin: $origin;
	-o-transform-origin: $origin;
	-ms-transform-origin: $origin;
	-webkit-transform-origin: $origin;
	transform-origin: $origin;
}

@mixin prefix($property, $value) {
	-webkit-#{$property}: #{$value};
	-moz-#{$property}: #{$value};
	-ms-#{$property}: #{$value};
	-o-#{$property}: #{$value};
	#{$property}: #{$value};
}
@mixin gradient($from, $to, $fallback) {
	background: $fallback;
	background: -moz-linear-gradient(top, $from 0%, $to 100%);
	background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,$from), color-stop(100%,$to));
	background: -webkit-linear-gradient(top, $from 0%, $to 100%);
	background: -o-linear-gradient(top, $from 0%, $to 100%);
	background: -ms-linear-gradient(top, $from 0%, $to 100%);
	background: linear-gradient(top bottom, $from 0%, $to 100%);
}
@mixin backface($visibility: hidden) {
	@include prefix('backface-visibility', #{$visibility});
}
@mixin box-sizing($box-sizing: border-box) {
	-webkit-box-sizing: #{$box-sizing};
	-moz-box-sizing: #{$box-sizing};
	box-sizing: #{$box-sizing};
}
@mixin border-radius($radius) {
	-webkit-border-radius: $radius;
	border-radius: $radius;
}
/*============================================================================
#Variable
==============================================================================*/
$gutter: 30px;
$main-color: {{ settings.color_main }};
$pry-color: {{ settings.color_main_1 }};
$border-color: {{ settings.color_borders }};
$font-base:  {{ base_family }};
$font-header:  {{ header_family }};
$font-accent:  {{ accent_family }};
$baseFontSize: {{ settings.type_base_size }};
$text-color: {{ settings.color_body_text }};
$header-bg-color: {{ settings.color_body_text }};
$footer-bg-color: {{ settings.color_body_text }};
$disabledGrey: #ddd;
$disabledBorder: #ddd;
@function em($pixels, $context: $baseFontSize) {
	@if (unitless($pixels)) {
		$pixels: $pixels * 1px;
	}
	@if (unitless($context)) {
		$context: $context * 1px;
	}
	@return $pixels / $context * 1em;
}



/*Update*/
$sale : {{settings.color_sale}};
$date : {{settings.color_date}};
$btn2 : {{settings.color_btn2}};
$btn-viewdesktop : {{settings.color_footer_desktop}};
$btt : {{settings.color_footer_btt}};
$hotline : {{settings.color_footer_hotline}};

footer .footer-info-widget p.hotline a{
	color: $hotline;
}
.product-box .sale-flash{
	background-color: $pry-color;
}
.blog-item .date{
	background: $date;
}
.off-canvas-menu .action .btn-primary.btn-50:last-child{
	background: $btn2;
	&:hover{
		background: lighten($btn2, 5%)
	}
}
.details-product form button.btn-primary2{
	background: $btn2;
	&:hover{
		background: lighten($btn2, 5%)
	}
}
.view-desktop a.btn.btn-primary.btn-full{
	background: $btn-viewdesktop;
	&:hover{
		background: lighten($btn-viewdesktop, 5%)
	}
}
