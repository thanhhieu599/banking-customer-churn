	top: -12px;
	right: -12px;
	width: 25px;
	height: 25px;
	cursor: pointer;
	z-index: 8040;
	color: #fff;
	text-align: center;
	background: #333;
	line-height: 25px;
	border-radius: 50%;
}
.quickview-info {
