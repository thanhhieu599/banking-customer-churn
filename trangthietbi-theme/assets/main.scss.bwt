			font-weight: 700;
			line-height: 40px;
			text-align: right;
			padding-right: 10px;
			span {
				color: red;
			}
		}
		.form-control {
			width: calc(100% - 110px);
		}
	}
	.title-head {
		font-weight: 400;
		font-size: 24px;
		text-transform: none;
		a {
			font-size: 14px;
			color: #f94e3f;
			font-weight: 400;
			text-transform: none;
			&:hover {
				color: #212121;
			}
		}
	}
	.address-group p {
		margin-bottom: 20px;
		> strong {
			display: inline-block;
			width: 130px;
			text-align: right;
			padding-right: 20px;
			color: #212121;
		}
	}
	.btn-style {
		color: #333;
		background: #ebebeb;
		&:hover {
			color: #fff;
		}
		&.btn-outline {
			background: none;
			border: 1px solid #ebebeb;
		}
	}
}

.btn-edit-addr {
	border: none;
	background: none;
	color: #f94e3f;
	&:hover {
		color: #212121;
	}
}

.article-readmore {
	line-height: 40px;
}

.block-account {
	.block-content p {
		margin: 10px 0;
		.fa {
			padding-right: 10px;
		}
	}
	.block-title h5 {
		font-size: 18px;
		font-weight: 700;
	}
}

.sortPagiBar {
	padding: 12px 20px;
	background-color: #FFF;
	border-radius: 0;
	margin-bottom: 30px;
	border: 1px #e1e1e1 solid;
	.form-group {
		margin-bottom: 0;
		float: right;
	}
}

.view-mode {
	padding: 10px 0;
}

.button-view-mode {
	input {
		display: none;
	}
	font-size: 18px;
	width: 20px;
	height: 34px;
	padding: 4px 7px;
	float: left;
	text-align: center;
	font-weight: 700;
	text-transform: uppercase;
	margin-right: 6px;
	border-radius: 0;
	margin-bottom: 0;
	height: 20px;
	height: 20px;
	position: relative;
}

.view-mode span {
	font-size: 14px;
	float: left;
	padding-right: 20px;
	transform: translateY(-3px);
	-webkit-transform: translateY(-3px);
	-o-transform: translateY(-3px);
	-moz-transform: translateY(-3px);
}

.button-view-mode {
	.fa {
		position: absolute;
		left: 0;
		top: 0;
	}
	&.active {
		background-color: none;
		color: #f94e3f;
	}
	&:hover {
		background-color: none;
		border-color: none;
		color: #f94e3f;
	}
	&.active:hover {
		background-color: none;
		color: #f94e3f;
	}
}

.form-viewpro {
	font-size: 14px;
	.form-control {
		width: 240px;
		border-radius: 0;
		border: 0;
		margin-left: 10px;
		background-color: #f7f7f7;
		color: #333;
		padding: 6px 10px;
		option:hover {
			background: #f94e3f !important;
			color: #FFF;
		}
	}
}

.pagination {
	padding-top: 0;
	margin-top: 30px;
	margin-bottom: 0px;
	padding-bottom: 0;
	.page-link {
		margin: 2.5px;
		width: 40px;
		background: #333;
		text-align: center;
		height: 40px;
		font-size: 16px;
		line-height: 24px;
		font-family: 'Arial', sans-serif;
		color: #fff;
		border-radius: 0;
		border: none;
		text-decoration: none;
		border-bottom: 1px transparent solid;
		&:hover {
			background-color: #f94e3f;
			border-bottom: 1px #f94e3f solid;
		}
	}
	.page-item {
		&.disabled .page-link {
			border: 0;
			display: none;
		}
		&.active .page-link {
			background-color: #f94e3f;
			border-color: #f94e3f;
			color: #fff;
			display: block;
		}
	}
}

.box-maps {
	margin-bottom: -8px;
}

.jssocials-share-logo {
	font-size: 16px;
	color: #333;
	line-height: 45px;
	&:hover {
		color: #111;
	}
}

.jssocials-share {
	margin: 0 10px;
	line-height: 26px;
	float: left;
}

.jssocials-shares {
	margin: 0;
}

.form-product label {
