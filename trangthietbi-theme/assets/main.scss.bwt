		.product-vendor {
			padding-bottom: 10px;
			border-bottom: 1px solid #ebebeb;
			margin-bottom: 18px;
			.line {
				padding: 0 3px 0 6px;
				transform: translateY(-1px);
				display: inline-block;
			}
		}
	}
	.product-policy ul {
		list-style: initial;
		padding-left: 20px;
		margin-top: 10px;
	}
}

.details-product {
	.product-price {
		font-size: 22px;
		font-weight: 700;
		line-height: 24px;
		margin-right: 10px;
	}
	.product-price-old {
		font-size: 22px;
		font-weight: 700;
		line-height: 24px;
		margin-right: 10px;
		text-decoration: line-through;
		font-weight: 400;
		color: #acacac;
		font-size: 16px;
	}
	.product-description {
		color: #636363;
		font-size: 14px;
		line-height: 24px;
		padding: 20px 0;
		margin-bottom: 30px;
		border-bottom: 1px #e1e1e1 solid;
	}
	div.form-group {
		padding: 20px 0;
		border-top: 1px solid #ebebeb;
		border-bottom: 1px solid #ebebeb;
		margin-top: 25px;
		width: 100%;
	}
}

.product-policy {
	margin-bottom: 30px;
}

.details-product {
	div.form-group.fix-margin {
		margin-top: 10px;
		margin-bottom: 20px;
	}
	form {
		a {
			color: #f94e3f;
			font-size: 18px;
		}
		&#add-to-cart-form a:hover {
			color: #fb6e0d;
		}
	}
	.custom-btn-number {
		max-width: 60px;
		padding: 0;
	}
	#add-to-cart-form .btn-cart {
		background-size: 20px;
		background-repeat: no-repeat;
		background-color: #f94e3f;
		background-position: 40px;
		padding-left: 30px;
		text-transform: inherit;
		margin-left: 10px;
		margin-right: 20px;
		font-weight: 300;
		border: none !important;
		svg {
			width: 16px;
			height: 14px;
			transform: translateY(1px);
		}
	}
	.form-product .btn-cart:hover {
		background-color: #f86906 !important;
	}
	.contact-info b {
		color: #f94e3f;
	}
	form {
		margin: 0;
	}
}

.product-sale-box {
	border: 1px dotted #f94e3f;
	padding: 15px 20px;
	margin-bottom: 30px;
	h4 {
		color: #f94e3f;
		text-transform: uppercase;
		font-size: 14px;
		font-weight: 700;
		img {
			padding-right: 5px;
			transform: translateY(-3px);
			-moz-transform: translateY(-3px);
			-o-transform: translateY(-3px);
			-webkit-transform: translateY(-3px);
		}
	}
}

.details-product {
	.custom-btn-number input {
		margin: 0;
		padding: 0;
	}
	.product-images {
		margin-bottom: 12px;
		.owl-nav div {
			bottom: 50%;
			background-color: transparent !important;
			color: #f94e3f;
			position: absolute;
			font-size: 20px;
		}
	}
}

.slideshow .owl-nav div {
	bottom: 50%;
	background-color: transparent !important;
	color: #f94e3f;
	position: absolute;
	font-size: 20px;
}

.details-product .product-images .owl-nav div:hover, .slideshow .owl-nav div:hover {
	color: #f94e3f;
}

.details-product .product-images .owl-nav .owl-prev, .slideshow .owl-nav .owl-prev {
	left: 0;
}

.details-product .product-images .owl-nav .owl-next, .slideshow .owl-nav .owl-next {
	right: 0;
}

.details-product .thumbnail-product {
	margin-bottom: 30px;
	img {
		border: 1px #FFF solid;
		&:hover {
			border: 1px #f94e3f solid;
		}
	}
}

.nav-tab-detailspro {
	margin-top: 50px;
	border-left: 1px #e1e1e1 solid;
	border-right: 1px #e1e1e1 solid;
	width: 100%;
	border-top: 1px solid #ebebeb;
	.nav-item {
		float: left;
		.nav-link {
			padding: 15px;
			font-size: 14px;
			line-height: 24px;
			font-weight: 700;
			text-transform: uppercase;
			margin-bottom: -1px;
			color: #363636;
			border-left: 1px solid #FFF;
			border-right: 1px solid #fff;
			&.active {
				color: #f94e3f;
				border-top: 1px solid #f94e3f;
				border-left: 1px solid #ebebeb;
				border-right: 1px solid #ebebeb;
				position: relative;
			}
		}
		+ .nav-item {
			margin-left: 0;
			float: left;
		}
		&:first-child .nav-link.active {
			border-left: 1px solid #FFF;
		}
		.nav-link.active {
			&:before {
				content: "";
				display: block;
				width: 100%;
				height: 2px;
				background: #f94e3f;
				position: absolute;
				top: -2px;
				left: 0;
			}
			&:after {
				content: "";
				display: block;
				width: 100%;
				height: 2px;
				background: #fff;
				position: absolute;
				bottom: -1px;
				left: 0;
			}
		}
	}
}

.tab-content-detailspro {
	float: left;
	padding: 30px 20px;
	width: 100%;
	border: 1px #ebebeb solid;
	font-size: 14px;
	line-height: 24px;
	color: #636363;
	margin-bottom: 50px;
	img {
		max-width: 100%;
	}
}

.related-product {
	margin-bottom: 30px;
	.title-head a {
		font-weight: 300;
		font-size: 20px;
		color: #333;
	}
	.owl-carousel.owl-loaded {
		border-top: 1px solid #ebebeb;
		border-right: 1px solid #ebebeb;
	}
	.heading {
		margin-bottom: 0;
	}
}

.banner-qc {
	max-width: 100%;
	margin-bottom: 30px;
}

.custom-btn-number {
	position: relative;
	padding: 0 30px 0 10px;
	border: 0;
	display: inline-block;
}

.qty {
	height: 43px;
	float: left;
	border: 1px #e1e1e1 solid;
	padding: 10px;
	width: 118px;
	text-align: center;
}

.items-count {
	height: 19px;
	text-align: center;
	float: left;
	background-color: #FFF;
	border: 1px #e1e1e1 solid;
	position: absolute;
	margin: 0 3px;
	font-weight: 300;
	font-size: 10px;
}

.increase {
	margin-bottom: 30px;
}

.reduced {
	bottom: 0;
}

.cart {
	margin-bottom: 100px;
	th {
		text-align: center;
	}
}

.table-cart {
	font-size: 15px;
	margin-bottom: 0;
	font-size: 13px;
	line-height: 37px;
	color: #252525;
	thead th {
		border-bottom: 0;
	}
	td {
		border-top: 1px #ebebeb solid;
	}
	th {
		border-top: 1px #ebebeb solid;
		vertical-align: middle !important;
	}
	td {
		vertical-align: middle !important;
	}
	a.remove-item {
		color: #252525;
		font-size: 20px;
	}
}

.inp-number {
	border-radius: 0;
	background-color: #FFF;
	border: 1px #ebebeb solid;
	max-width: 50px;
	padding-left: 10px;
	text-align: center;
}

.table-cart-total {
	margin-top: 30px;
}

.tag_article {
	float: left;
	width: 100%;
	font-size: 14px;
	line-height: 30px;
	color: #636363;
}

.social-media {
	float: left;
	width: 100%;
	font-size: 14px;
	line-height: 30px;
	color: #636363;
	border-top: 1px solid #ebebeb;
	border-bottom: 1px solid #ebebeb;
}

.tag_article h2, .social-media h2 {
	margin: 0;
	display: inline-block;
	font-size: 14px;
	font-weight: 700;
	color: #363636;
	line-height: 45px;
}

.tag_article a, .social-media a {
	color: #636363;
}

.tag_article a:hover {
	color: #f94e3f;
	text-decoration: none;
}

.social-media {
	a:hover {
		color: #f94e3f;
		text-decoration: none;
	}
	ul {
		list-style-type: none;
		padding: 0;
		display: inline-block;
		li {
			display: inline-block;
			a {
				padding: 0 6px;
			}
		}
	}
}

.product-box {
	text-align: left;
	margin: 1px;
	background: #fff;
	position: relative;
	&:before {
		content: "";
		width: 100%;
		height: 100%;
		background: rgba(255, 255, 255, 1);
		position: absolute;
		top: 0;
		left: 0;
	}
}

.product-info {
	z-index: 10;
	position: relative;
}

.products-view-grid .product-info {
	min-height: 93px;
	padding: 0 30px;
	padding-bottom: 18px;
}

.home-products .product-info .product-name, .products-view-grid .product-info .product-name {
	padding: 0;
}

.product-box {
	.product-thumbnail {
		display: -webkit-flex;
		-webkit-align-items: center;
		display: -ms-flexbox;
		display: flex;
		-webkit-align-items: center;
		-ms-flex-align: center;
		align-items: center;
		position: relative;
		margin-bottom: 30px;
		> a {
			display: block;
			width: 100%;
			padding: 20px;
			max-height: 200px;
			height: 200px;
			text-align: center;
		}
		a img {
			width: auto;
			height: 100%;
			-webkit-flex: 1;
			-ms-flex: 1;
			flex: 1;
		}
	}
	.product-name {
		font-size: 14px;
		line-height: 20px;
		color: #252525;
		padding: 0 10px 2px;
		a {
			color: #252525;
			text-decoration: none;
			&:hover {
				color: #f94e3f;
			}
		}
	}
	.product-price {
		color: #f94e3f;
		font-size: 14px;
		line-height: 20px;
		display: inline-block;
		font-weight: 700;
		margin-bottom: 6px;
	}
}

.product-price {
	color: #f94e3f;
	font-size: 14px;
	line-height: 20px;
	display: inline-block;
	font-weight: 700;
	margin-bottom: 6px;
}

.product-box {
	.product-price-old {
		text-decoration: line-through;
		font-size: 12px;
		margin: 0 0 0 10px;
		display: inline-block;
		color: #939393;
	}
	.sale-flash {
		position: absolute;
		font-size: 14px;
		color: #FFF;
		padding: 1px 10px;
		line-height: 24px;
		text-align: center;
		top: 10px;
		left: 0;
		z-index: 99;
		background-color: #f94e3f;
		&:before {
			border-top: 13px solid #f94e3f;
			border-bottom: 13px solid transparent;
			border-right: 10px solid transparent;
			content: "";
			position: absolute;
			bottom: 100%;
			margin: 0;
			left: 100%;
			top: 0;
			z-index: 100;
		}
		&:after {
			border-top: 13px solid transparent;
			border-bottom: 13px solid #f94e3f;
			border-right: 10px solid transparent;
			content: "";
			position: absolute;
			bottom: 100%;
			margin: 0;
			left: 100%;
			top: 0;
			z-index: 100;
		}
	}
	.product-summary {
		font-size: 14px;
		color: #acacac;
		line-height: 20px;
	}
}

.pro-action-btn {
	position: absolute;
	top: 0;
	left: 0;
	text-align: center;
	width: 100%;
	height: 100%;
	z-index: 3;
	overflow: hidden;
	background-color: rgba(255, 255, 255, 0.7);
	transition: All .3s ease;
	-webkit-transition: All .3s ease;
	-moz-transition: All .3s ease;
	-o-transition: All .3s ease;
	transform: scale(0);
	-webkit-transform: scale(0);
	-moz-transform: scale(0);
	-o-transform: scale(0);
	-ms-transform: scale(0);
	display: -webkit-flex;
	-webkit-align-items: center;
	display: -ms-flexbox;
	display: flex;
	-webkit-align-items: center;
	-ms-flex-align: center;
	align-items: center;
	div {
		-webkit-flex: 1;
		-ms-flex: 1;
		flex: 1;
	}
	.btn {
		background-color: #f94e3f;
		min-width: 100px;
		color: #FFF;
		font-size: 14px;
		line-height: 29px;
		padding: 0;
		margin: 2px;
		height: 30px;
		text-transform: inherit;
		display: inline-block;
		min-height: 30px;
		font-weight: 400;
		&:hover {
			background-color: #f4690b !important;
			border: 1px solid #f4690b;
		}
	}
}

.product-box:hover .pro-action-btn {
	transform: scale(1);
	-webkit-transform: scale(1);
	-moz-transform: scale(1);
	-o-transform: scale(1);
	-ms-transform: scale(1);
}

.home-products .product-box:hover {}

.products-view-grid {
	.product-box:hover {
		z-index: 99;
		-webkit-box-shadow: 0 0 10px 0 rgba(206, 206, 206, 1);
		-moz-box-shadow: 0 0 10px 0 rgba(206, 206, 206, 1);
		box-shadow: 0 0 10px 0 rgba(206, 206, 206, 1);
	}
	margin-bottom: 30px;
}

.products-view-list {
	margin-bottom: 30px;
	.col-xs-12:first-child .product-box {
		padding-top: 25px;
	}
}

.products-view-grid {
	.product-box {
		margin: 0;
		position: relative;
		border: 1px solid #ebebeb;
		border-right: 0 none;
		border-top: 0 none;
	}
	.col-sm-6 {
		&:nth-child(1) .product-box, &:nth-child(2) .product-box, &:nth-child(3) .product-box {
			border-top: 1px solid #ebebeb;
		}
		&:nth-child(3n) .product-box, &:last-child .product-box {
			border-right: 1px solid #ebebeb;
		}
	}
}

.products-view-list {
	margin-bottom: 30px;
	> .row {
		border: 1px solid #ebebeb;
	}
	.col-xs-12:first {
		padding-top: 30px;
	}
	.product-box {
		.product-name a {
			font-size: 14px;
			font-weight: 700;
			color: #333;
			&:hover {
				color: #f94e3f;
			}
		}
		margin-bottom: 25px;
		padding-bottom: 20px;
		overflow: hidden;
		border-bottom: 1px solid #ebebeb;
	}
	.col-xs-12:last-child .product-box {
		border-bottom: none;
	}
	.product-box {
		&:hover {
			outline: 0 solid #ebebeb;
		}
		.product-thumbnail {
			text-align: center;
			margin-bottom: 0;
			width: calc(100% / 3);
			float: left;
		}
		.product-name {
			font-size: 20px;
		}
		.product-thumbnail img {}
		.product-name {
			padding: 0;
			font-size: 24px;
			line-height: 20px;
			margin: 5px 0 5px;
			&:hover {
				text-decoration: none;
			}
		}
		.product-summary {
			font-size: 14px;
			line-height: 24px;
			color: #8d8d8d;
			margin: 6px 0;
			margin-bottom: 20px;
			padding-right: 30px;
		}
		.pro-action-btn {
			margin-bottom: 15px;
			position: relative;
			text-align: left;
			transform: scale(1);
			-webkit-transform: scale(1);
			-moz-transform: scale(1);
			-o-transform: scale(1);
			-ms-transform: scale(1);
			.btn {
				opacity: 1;
				line-height: 29px;
				&:hover {
					background: #f4690b;
					border-color: #f4690b;
				}
			}
		}
		.sale-flash {
			z-index: 9;
			top: 20%;
			left: 0;
		}
	}
}

.products-view-grid .product-box {
	.product-summary, .form-nut-list {
		display: none;
	}
}

.products-view-list {
	.product-box .form-nut-grid {
		display: none;
	}
	.product-info {
		text-align: left;
		margin-left: 30px;
		float: left;
		width: calc(100% / 3 * 2 - 30px);
	}
}

.list-category {
	.btn {
		height: 30px;
	}
	h3 {
		font-size: 18px;
		margin: 0;
	}
}

.btn-search {
	background-color: transparent;
	color: #898989;
	position: relative;
	z-index: 2;
}

.search-box {
	position: relative;
	float: left;
	width: 55px;
	height: 55px;
	.form-control {
		position: absolute;
		top: 10px;
		right: 6px;
		display: none;
	}
	.btn-s2 {
		visibility: hidden;
		opacity: 0;
		position: absolute;
		left: -12px;
		padding: 6px 20px;
		margin: 10px 5px;
		background-color: #f94e3f;
		color: #FFF;
		border-radius: 0 5px 5px 0;
		transition: All 1s ease;
		-webkit-transition: All 1s ease;
		-moz-transition: All 1s ease;
		-o-transition: All 1s ease;
	}
	.form-control {
		display: block;
	}
	.btn-s2 {
		opacity: 1;
		visibility: visible;
	}
	.btn-s1 {
		display: none;
	}
}

.bread-crumb {
