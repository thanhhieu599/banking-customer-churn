				text-align:left;
				border: 1px solid #eee;
				padding: 7px;
				font-size: 14px;
				position: relative;
				color: $main-color;
				&:after{
					content: "\f107";
					font-family: FontAwesome;
					font-size: 15px;
					position: absolute;
					right: 10px;
					line-height: 21px;
					transition: all 0.55s 0.25s;
