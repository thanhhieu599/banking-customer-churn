				i{
					display: table-cell;
					width: 20px;
				}
				a{
					color: #666;
					&:hover, &:focus{
						color: #288ad6;
					}
				}
			}
		}
		.social{
			margin-top: 10px;
			li{
				display: inline-block;
				margin-right: 3px;
				a{
					display: inline-block;
					background-color: #493f49;
					width: 35px;
					font-size: 15px;
					height: 35px;
					line-height: 35px;
					border-radius: 50%;
					text-align: center;
					position: relative;
					svg{
						height: 20px;
						width: 20px;
						position: absolute;
						top: 0;
						bottom: 0;
						left: 0;
						right: 0;
						margin: auto;
						path{
							fill: #fff !important;
						}
					}
					&:hover{
						opacity: 0.8;
					}
				}
				&.fb{
					a{
						background-color: #3b5998;
					}
				}
				&.tt{
					a{
						background-color: #1da1f2;
					}
				}
				&.yt{
					a{
						background-color: #ff0000;
					}
				}
				&.ins{
					a{
						background-color: #5851db;
					}
				}
			}
		}
		.footer-payment{
			img{
				display: inline-block;
				margin-right: 3px;
				margin-bottom: 7px;
				vertical-align: middle;
			}
		}
	}
}
