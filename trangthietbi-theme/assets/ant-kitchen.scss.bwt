}
.category-gallery {
	margin-bottom: 20px;
}
.collections_des_and_menu_list{
	margin-bottom: 15px;
	margin-top: 15px;
	ul{
		li{
			margin-bottom: 10px;
			a{
				display: block;
				padding: 7px 14px;
				border-radius: 5px;
				border: 1px solid #efefef;
				color: #222;
				&:hover, &:focus{
					text-decoration:none;
					color: $main-color;
					border-color: $main-color;
				}
			}
			&.active{
				a{
					color: $main-color;
					border-color: $main-color;
				}
			}
		}
	}
}
.collections_des_and_menu-content{
	margin-bottom: 15px;
}
.logos{
	img{
		margin-bottom: 15px;
		max-width: 200px;
	}
}
.contact-info-page{
	li{
		display: table;
		margin-bottom: 10px;
		i {
			display: table-cell;
			width: 20px;
			text-align: center;
		}
		a{
			color: #333;
			&:hover, &:focus{
				color: $main-color;
			}
		}
	}
}
.required{color: red;}
.btn-blues{
	color: #fff;
	background-color: $main-color;
	border-color: $main-color;
	&:hover, &:focus{
		background-color: darken($main-color, 10);
		border-color: darken($main-color, 10);
		color: #fff;
	}
}
.account-page{
	h2{
		margin-top: 0;
		font-size: 16px;
	}
}
#order_details{
	.thead-default{
		@media(min-width: 992px){
			border-top: 1px solid #e5e5e5;
		}
	}
}
.pagging-css{
	margin: 10px 0;
	padding-top: 10px;
	padding-bottom: 5px;
	background-color: #f8f8f8;
	.pagination{
		margin: 0;
	}
}
.pss {
	display: none;
}
.cart_desktop_page form{margin-bottom: 0;}
/*Cart Mobile*/
.cart-mobile {
	padding: 10px 0px 0px 0px;
	.header-cart {
		padding: 10px 0px 0px;
		border-bottom: solid 1px #ebebeb;
		margin-top: -10px;
	}
	.title-cart {
		line-height: 10px;
		h3 {
			font-size: 14px;
			font-weight: 500;
			text-transform: uppercase;
		}
		a{
			margin-top: -30px !important;
		}
	}
	.header-cart-content {
		margin-top: 10px;
		.content-product-list {
			min-height: 110px;
			.item-product {
				min-height: 110px;
				border-bottom: solid 1px #ebebeb;
				overflow: hidden;
				display: table;
				width:100%;
				margin-bottom:10px;
			}
		}
	}
}
.item-product-cart-mobile {
	width: 115px;
	margin-right: 10px;
}
.item-product-cart-mobile img {
	max-width: 115px;
	margin-right: 10px;
}
.item-product .title-product-cart-mobile {
	//max-width: 150px;
}
.title-product-cart-mobile{
	h3 {
		line-height: 1;
		margin: 0;
		font-weight: normal;
	}
	a {
		word-break: break-word;
		font-size: 14px;
		color: #363636;
	}
	p {
		line-height: 2;
		font-size: 14px;
		color: #898989;
	}
	span {
		color: #d0021b;
	}
}
.item-product-cart-mobile, .title-product-cart-mobile/*, .select-item-qty-mobile */{
	//float: left;
	display: table-cell;
	vertical-align: top;
	padding-right: 5px;
}
.select-item-qty-mobile {
	float: right;
	text-align: center;
	margin-top:10px;
	.txt_center input {
		height: 25px;
		width: 24px;
		text-align: center;
		margin: 0px;
		padding: 0;
		position: absolute;
		left: 22px;
		min-height: 0;
		border: solid thin #ddd;
	}
}
.select-item-qty-mobile>div {
	position: relative;
	width: 68px;
	height: 25px;
}
.cart-mobile .select-item-qty-mobile .txt_center button.reduced.items-count.btn-minus {
	position: absolute;
	left: 0;
	top: 0;
	//z-index: 100;
	margin: 0;
	line-height: 1;
	height: 25px;
	border-style: hidden;
	background: none !important;
	color: #000;
	border: solid thin #ddd;
}
.cart-mobile .select-item-qty-mobile .txt_center button.increase.items-count.btn-plus {
	position: absolute;
	right: 0;
	top: 0;
	margin: 0;
	height: 25px;
	display: inline-block;
	line-height: 1;
	border-style: hidden;
	color: #fff;
	background: none !important;
	color: #000;
	border: solid thin #ddd;
}
.select-item-qty-mobile a {
	line-height: 3;
	color: #363636;
}
.cart-mobile{
	.header-cart-price {
		padding: 18px 0px;
		padding-bottom:0;
	}
	.title-cart {
		h3 {
			font-size: 14px;
			font-weight: 500;
			text-transform: uppercase;
			margin-top: 0;
		}
		a {
			float: right;
			margin-top: -28px;
			color: #d0021b;
			font-size: 16px;
			line-height: 27px;
		}
	}
}
.btn-proceed-checkout-mobile {
	width: 100%;
	line-height: 27px;
	color: #fff;
	height: 40px;
	font-size: 14px;
	border: none;
	background: $main-color;
	text-transform: uppercase;
}
.btn-proceed-continues-mobile {
	background-color: #fff !important;
	color: $main-color !important;
	width: 100%;
	height: 40px;
	margin-top: 10px;
	text-transform: uppercase;
	border: 1px solid $main-color;
	line-height: 38px;
}
.shopping-cart-item {
	background-color: transparent;
	padding: 15px 0;
	margin: 0;
	&+.shopping-cart-item {
		border-top: 1px solid #e5e5e5;
	}
	.col-xs-3 {
		padding-left: 0;
		p{
			margin: 0;
		}
	}
	.col-right {
		padding-left: 0;
		.box-info-product {
			width: 350px;
			padding-right: 10px;
			padding-left: 10px;
			float: left;
			@media(max-width: 1024px){
				width: 270px;
			}
			.name {
				font-size: 14px;
				margin-bottom: 7px;
				line-height: 20px;
				font-weight: 500;
				padding-top: 0;
				a {
					color: #242424;
					font-weight: 500;
					&:hover, &:focus{
						color: $main-color;
						text-decoration: none;
					}
				}
			}
			.seller-by {
				font-size: 13px;
				margin-bottom: 12px;
			}
			.action {
				position: relative;
				padding: 0!important;
				margin-bottom: 0;
				margin-top: 0;
				.btn-link {
					border: 0;
					color:$main-color;
					font-size: 13px;
					position: static;
					padding: 0;
					line-height: 1.1;
				}
			}
		}
		.box-price {
			float: left;
			width: 110px;
			padding-right: 10px;
			.price {
				font-size: 16px;
				margin-bottom: 5px;
				font-weight: 500;
				padding-top: 0;
				color: #d0021b;
			}
		}
		.quantity-block {
			width: 120px;
			float: right;
			.input-group-btn {
				button{
					height: 28px;
					&.bootstrap-touchspin-down{
						border-radius: 3px 0 0 3px;
						border: 1px solid #e5e5e5;
						border-right: 0;
						border-color: #e5e5e5;
						color: #999;
						line-height: 20px;
						padding: 3px 9px;
						margin: 0;
						width: 28px;
						background-color: #fff;
						float: right;
					}
					&.bootstrap-touchspin-up{
						border-radius: 0 3px 3px 0;
						border: 1px solid #e5e5e5;
						border-color: #e5e5e5;
						border-left: 0;
						color: #999;
						line-height: 20px;
						padding: 3px 9px;
						margin: 0;
						width: 28px;
						background-color: #fff;
						float: right;
					}
					&:focus, &:hover{
						outline: none;
						box-shadow: none;
						-webkit-appearance: none;
						-moz-appearance: none;
					}
				}
				.js-quantity-product{
					display: inline-block;
					height: 28px;
					padding: 0 5px;
					text-align: center;
					border-radius: 0;
					width: 35px;
					float: right;
					min-height: 28px;
					border: 1px solid #e5e5e5;
				}
			}
		}
	}
}
#right-affix{
	.each-row {
		width: 100%;
		clear: both;
		.box-style {
			background-color: transparent;
			padding: 17px 0 21px 0;
			&.fee{
				.list-info-price {
					margin: 0;
					span {
						font-weight: 500;
					}
					strong {
						float: right;
						font-weight: 700;
						color: #d0021b;
					}
				}
				.total2 {
					font-weight: 500;
					.text-label {
						margin-top: 5px;
						display: inline-block;
					}
					.amount {
						float: right;
						p {
							margin: 0;
							text-align: right;
							line-height: 1.1;
							strong {
								color: #d0021b;
								font-size: 22px;
								font-weight: 700;
							}
							small {
								font-weight: 500;
							}
						}
					}
				}
			}
			&+.box-style{
				border-top: 1px solid #f4f4f4;
			}
		}
	}
	.btn-checkout {
		margin-top: 10px;
		padding: 10px;
		margin-bottom: 0;
		font-weight: 400;
		text-align: center;
		vertical-align: middle;
		touch-action: manipulation;
		cursor: pointer;
		border: 1px solid transparent;
		white-space: nowrap;
		font-size: 14px;
		line-height: 1.42857;
		border-radius: 4px;
		user-select: none;
		color: #fff;
		background-color: $main-color;
		border-color: $main-color;
		height: 40px;
		&:hover, &:focus{
			background-color: darken($main-color, 10%);
			border-color: darken($main-color, 10%);
		}
	}
	.btn-checkouts{
		margin-top: 10px;
		padding: 10px;
		margin-bottom: 0;
		font-weight: 400;
		text-align: center;
		vertical-align: middle;
		touch-action: manipulation;
		cursor: pointer;
		border: 1px solid transparent;
		white-space: nowrap;
		font-size: 14px;
		line-height: 1.42857;
		border-radius: 4px;
		user-select: none;
		color: $main-color;
		background-color: #fff;
		border-color: $main-color;
		height: 40px;
		&:hover, &:focus{
			outline:none;
			box-shadow: none;
			background-color: #fff;
			border-color: darken($main-color, 10%);
			color: darken($main-color, 10%); 
		}
	}
}
/*END Giỏ hàng*/
/*Giỏ hàng*/
.lbl-shopping-cart-gio-hang {
	margin-top: 20px;
	&.lbl-shopping-cart {
		color: #333;
		font-size: 18px;
		text-transform: uppercase;
		font-weight: 500;
		margin-bottom: 12px;
		span {
			font-size: 14px;
			text-transform: none;
			font-weight: 400;
		}
	}
}
.shopping-cart .shopping-cart-table table tbody tr .cart-product-name-info h4 a:hover,
.shopping-cart .shopping-cart-table table tbody tr .cart-product-name-info h4 a:focus {
