}
.shopping-cart .shopping-cart-table table tbody tr td {
	vertical-align: middle;
}
.shopping-cart .cart-image img {
	width:150px
}
.cart-shopping-total {background:#f8f8f8}
.shopping-cart .shopping-cart-table table tbody tr .romove-item a {
	font-size: 18px;
