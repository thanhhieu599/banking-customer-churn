/* ================================================================
   THẺ SẢN PHẨM ĐỒNG ĐỀU (dùng cho snippet product-grid-item)
   ================================================================ */

/* ----- Thẻ: cao bằng ô chứa nó, chia theo cột ----- */
.product-box {
	display: flex;
	flex-direction: column;
	height: 100%;
}

/* ----- Khung ảnh vuông cố định, nền trắng ----- */
.product-box .product-thumbnail {
	position: relative;
	flex: 0 0 auto;
	background: #fff !important;
}
.product-box .product-image-flip {
	display: block;
	aspect-ratio: 1 / 1;
	overflow: hidden;
	background: #fff !important;
}
.product-box .product-image-flip a {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 100%;
	background: #fff !important;
}
.product-box .product-image-flip img {
	width: 100%;
	height: 100%;
	max-width: 100%;
	object-fit: contain;      /* đổi thành "cover" nếu muốn ảnh phủ kín, chấp nhận bị cắt mép */
	object-position: center;
}

/* ----- Khung thông tin: căn trái đồng nhất ----- */
.product-box .product-info {
	display: flex;
	flex: 1;
	flex-direction: column;
	padding: 10px 12px 12px;
	text-align: left !important;
}

/* ----- Tên: tối đa 2 dòng ----- */
.product-box .product-name {
	margin: 0 0 6px;
	font-size: 14px;
	font-weight: 600;
	line-height: 1.4;
	height: auto;
	min-height: 2.8em;
	text-align: left !important;
}
.product-box .product-name a {
	display: -webkit-box !important;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
	white-space: normal !important;
	text-overflow: clip !important;
	color: #222;
}
.product-box .product-name a:hover { color: #bf2026; }

/* ----- Giá: căn trái, giá cũ cùng hàng ----- */
.product-box .price-box {
	display: flex;
	flex-wrap: wrap;
	align-items: baseline;
	gap: 2px 8px;
	min-height: 26px;
	margin: 0 0 8px;
	text-align: left !important;
}
.product-box .price-box .special-price,
.product-box .price-box .old-price {
	float: none !important;
	display: block;
	margin: 0;
	text-align: left !important;
}
.product-box .price-box .product-price {
	font-size: 17px;
	font-weight: 700;
	color: #c1121f;
}
.product-box .price-box .product-price-old {
	font-size: 13px;
	color: #999;
}
.product-box .pcx-contact-price {
	font-size: 14px !important;
	font-weight: 600 !important;
	color: #666 !important;
}

/* ----- Sao, đã bán: sát nhau, căn trái ----- */
.product-box .pcx-rating { margin: 0 0 4px; }
.product-box .pcx-sold { margin: 0 0 6px; }

/* ----- Ô số lượng: ẩn trong thẻ danh sách (mặc định 1, đổi ở giỏ hàng) ----- */
.product-box .pcx-qty { display: none; }

/* ----- Nút: sát đáy thẻ, rộng hết khung ----- */
.product-box .pcx-actions {
	margin-top: auto;
	padding-top: 6px;
}
.product-box .pcx-form { gap: 0; }
.product-box .pcx-btn {
	flex: 1 1 100%;
	min-width: 0;
	height: 38px;
	border-radius: 6px;
	font-size: 13px;
}

/* ================================================================
   SLIDER OWL: các thẻ cùng hàng cao bằng nhau
   ================================================================ */
.owl-carousel .owl-stage {
	display: flex;
}
.owl-carousel .owl-item {
	display: flex;
	height: auto;
}
.owl-carousel .owl-item > .item {
	display: flex;
	width: 100%;
}
.owl-carousel .owl-item > .item > .product-box {
	width: 100%;
}
