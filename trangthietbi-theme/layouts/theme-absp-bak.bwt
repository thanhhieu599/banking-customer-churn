<!DOCTYPE html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">			
		<title>{%if page_title == 'All'%}Tất cả sản phẩm{% elsif template == "search" %}Tìm kiếm sản phẩm{%else%}{{ page_title }}{%endif%}{% if current_tags %} tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} - Trang {{ current_page }}{% endif %}{% unless page_title contains store.name %} | {{ store.name }}{% endunless %}</title>		
		{% if page_description != ""%}
		<meta name="description" content="{{ page_description | escape }}">
		{% endif %}
		{%if template contains 'index'%}{%if settings.home_page_keywords != '' and settings.home_page_keywords != null%}<meta name="keywords" content="{{settings.home_page_keywords}}"/>{%else%}<meta name="keywords" content="{{store.name}}, {{store.domain}}"/>{%endif%}{%elsif template contains 'product'%}<meta name="keywords" content="{{product.name}}, {%for collection in product.collections%}{{collection.name}}, {%endfor%}{%if product.tags.size > 0%}{% for tag in product.tags %}{{tag}}, {%endfor%}{%endif%}{{store.name}}, {{store.domain}}"/>{%elsif template contains 'collection'%}<meta name="keywords" content="{{collection.name }}, {{store.name}}, {{store.domain}}"/>{%elsif template contains 'blog'%}<meta name="keywords" content="{{blog.name }}, {{store.name}}, {{store.domain}}"/>{%elsif template contains 'article'%}<meta name="keywords" content="{{article.title}}, {{blog.name}}, {%if article.tags.size > 0%}{% for tag in article.tags %}{{tag}}, {%endfor%}{%endif%} {{store.name}}, {{store.domain}}"/>{%else%}<meta name="keywords" content="{{page_title}}, {{store.name}}, {{store.domain}}"/>{%endif%}		
		<link rel="canonical" href="{{ canonical_url }}"/>
		{% if template == 'article' %}
		<link rel="amphtml" href="{{ canonical_url }}?view=amp" />
		{% endif %}
		<meta name='revisit-after' content='1 days' />
		<meta name="robots" content="noodp,index,follow" />
		{%if settings.favicon_enable%}<link rel="icon" href="{{ 'favicon.png' | asset_url }}" type="image/x-icon" />{%endif%}
		{% include 'fb-open-graph-tags' %}
		<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">
		<link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
		
		<link rel="preload" as="style" type="text/css" href="{{ 'base.scss.css' | asset_url }}" />
		{{ 'base.scss.css' | asset_url | stylesheet_tag }}	
		
		<link rel="preload" as="style" type="text/css" href="{{ 'ant-kitchen.scss.css' | asset_url }}" />
		{{ 'ant-kitchen.scss.css' | asset_url | stylesheet_tag }}
		
		<link rel="preload" as="style" type="text/css" href="{{ 'edit.scss.css' | asset_url }}" />
		{{ 'edit.scss.css' | asset_url | stylesheet_tag }}
		
		{% include 'jquery' %}
		{% if template contains 'customer' %}
		{{ 'bizweb-api.js'  | bizweb_asset_url | script_tag }}
		{{ 'common.js' | bizweb_asset_url | script_tag }}   
		{{ 'customer.js'  | bizweb_asset_url | script_tag }}
		{% endif %}
		
		{{ content_for_header }}
		
		{%- if template contains 'product' -%}<script rel="dns-prefetch" type="text/javascript" >var ProductReviewsAppUtil=ProductReviewsAppUtil || {};{% if customer %}ProductReviewsAppUtil.customer={id: '{{customer.id}}',name: '{{customer.name}}',email: '{{customer.email}}'};{% endif %}</script>{%-endif-%}

		{% include 'evo-schema' %}
	</head>
	<body class="{% if template == "index" %}bg-index{% endif %}{% if template =="page.contact" %}contact-page-edit{% endif %}">
		<div id="box-wrapper">
			{% include 'header' %}
			{{ content_for_layout }}
			{% if template contains 'product' %}{% include 'bpr-products-module' %}{% endif %}
			{% include 'footer' %}	
		</div>
		{% if settings.display_suggest_search %}
		{{ 'rx.all.min.js' | asset_url | script_tag }}
		{% endif %}
		{{ 'option-selectors.js' | asset_url | script_tag }}
		{{ 'api.jquery.js' | bizweb_asset_url | script_tag }} 			
		<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js" integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa" crossorigin="anonymous"></script>
		{{ 'https://cdnjs.cloudflare.com/ajax/libs/jquery-form-validator/2.3.26/jquery.form-validator.min.js'| script_tag }}
		<script>$.validate({});</script>	
		{% include 'template-popup' %}
		{% include 'api.jquery.custom' %}		
		{% include 'popup-cart' %}
		{% include 'menu-mobile' %}
		<div class="backdrop__body-backdrop___1rvky"></div>
		{{ 'appear.js' | asset_url | script_tag }}
		{{ 'cs.script.js' | asset_url | script_tag }}
		{%if settings.quickview_enable%}			
		{% include 'quickview-template' %}
		<script>
			{% include 'quickview.js' %} 				
		</script>
		{%endif%}
		{{ 'main.js' | asset_url | script_tag }}				
		{% if template contains 'product' %}
		{{ 'lightbox.css' | asset_url | stylesheet_tag }}
		{%if settings.product_zoom_enable%}
		{{ 'jquery.elevatezoom308.min.js' | asset_url | script_tag }}		
		{%endif%}

		{%if settings.product_lightbox_enable%}		
		{{ 'jquery.prettyPhoto.min005e.js' | asset_url | script_tag }}
		{{ 'jquery.prettyPhoto.init.min367a.js' | asset_url | script_tag }}
		{%endif%}
		{%endif%}	
		{% include 'support' %}
		{% if template contains 'collection' %}
		<script>
			var filter = new Bizweb.SearchFilter()
			{% if collection.id > 0 %}
			filter.addValue("collection", "collections", "{{ collection.id }}", "AND");
							{% endif %}
							function clearAllFiltered() {
				filter = new Bizweb.SearchFilter();
				{% if collection.id > 0 %}
				filter.addValue("collection", "collections", "{{ collection.id }}", "AND");
								{% endif %}

								$(".filter-container__selected-filter-list ul").html("");
				$(".filter-container input[type=checkbox]").attr('checked', false);
				$(".filter-container__selected-filter").hide();

				doSearch(1);
			}
		</script>
		{{ 'col.js' | asset_url | script_tag }}		
		{% endif %}

		<!-- Load Facebook SDK for JavaScript -->
		<div id="fb-root"></div>
		<script>
			setTimeout(function(){	
				window.fbAsyncInit = function() {
					FB.init({
						xfbml            : true,
						version          : 'v7.0'
					});
				};

				(function(d, s, id) {
					var js, fjs = d.getElementsByTagName(s)[0];
					if (d.getElementById(id)) return;
					js = d.createElement(s); js.id = id;
					js.src = 'https://connect.facebook.net/en_US/sdk/xfbml.customerchat.js';
					fjs.parentNode.insertBefore(js, fjs);
				}(document, 'script', 'facebook-jssdk'));
			},7000);
		</script>

		<!-- Your Chat Plugin code -->
		<div class="fb-customerchat"
			 attribution=setup_tool
			 page_id="2052554291739333">
		</div>

		{% include 'chatzalo' %}
	{% include 'loyalty' %}
</body>
</html>
