		{{ 'rx.all.min.js' | asset_url | script_tag }}
		{% endif %}
		{{ 'option-selectors.js' | asset_url | script_tag }}
		{{ 'api.jquery.js' | bizweb_asset_url | script_tag }} 			
		<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js" integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa" crossorigin="anonymous"></script>
		{{ 'https://cdnjs.cloudflare.com/ajax/libs/jquery-form-validator/2.3.26/jquery.form-validator.min.js'| script_tag }}
		<script>$.validate({});</script>	
		{% include 'template-popup' %}
		{% include 'api.jquery.custom' %}		
		{% include 'popup-cart' %}
		{% include 'menu-mobile' %}
		<div class="backdrop__body-backdrop___1rvky"></div>
		{{ 'appear.js' | asset_url | script_tag }}
		{{ 'cs.script.js' | asset_url | script_tag }}
		{%if settings.quickview_enable%}			
		{% include 'quickview-template' %}
		<script>
			{% include 'quickview.js' %} 				
		</script>
		{%endif%}
		{{ 'main.js' | asset_url | script_tag }}				
		{% if template contains 'product' %}
		{{ 'lightbox.css' | asset_url | stylesheet_tag }}
		{%if settings.product_zoom_enable%}
		{{ 'jquery.elevatezoom308.min.js' | asset_url | script_tag }}		
		{%endif%}

		{%if settings.product_lightbox_enable%}		
		{{ 'jquery.prettyPhoto.min005e.js' | asset_url | script_tag }}
		{{ 'jquery.prettyPhoto.init.min367a.js' | asset_url | script_tag }}
		{%endif%}
		{%endif%}	
		{% include 'support' %}
		{% if template contains 'collection' %}
		<script>
			var filter = new Bizweb.SearchFilter()
			{% if collection.id > 0 %}
			filter.addValue("collection", "collections", "{{ collection.id }}", "AND");
							{% endif %}
							function clearAllFiltered() {
				filter = new Bizweb.SearchFilter();
				{% if collection.id > 0 %}
				filter.addValue("collection", "collections", "{{ collection.id }}", "AND");
								{% endif %}

								$(".filter-container__selected-filter-list ul").html("");
				$(".filter-container input[type=checkbox]").attr('checked', false);
				$(".filter-container__selected-filter").hide();

				doSearch(1);
			}
		</script>
		{{ 'col.js' | asset_url | script_tag }}		
		{% endif %}

		<!-- Load Facebook SDK for JavaScript -->
		<div id="fb-root"></div>
		<script>
			setTimeout(function(){	
				window.fbAsyncInit = function() {
					FB.init({
						xfbml            : true,
						version          : 'v7.0'
					});
				};

				(function(d, s, id) {
					var js, fjs = d.getElementsByTagName(s)[0];
					if (d.getElementById(id)) return;
					js = d.createElement(s); js.id = id;
					js.src = 'https://connect.facebook.net/en_US/sdk/xfbml.customerchat.js';
					fjs.parentNode.insertBefore(js, fjs);
				}(document, 'script', 'facebook-jssdk'));
			},7000);
		</script>

		<!-- Your Chat Plugin code -->
		<div class="fb-customerchat"
			 attribution=setup_tool
			 page_id="2052554291739333">
		</div>

	{% include 'chatzalo' %}
	{% include 'loyalty' %}
	{{ 'appbulk-product-statistics.js' | asset_url | script_tag }}
	{% include 'popup-dang-ky' %}
<script src="{{ 'pcx-sold.js' | asset_url }}" defer></script>
<script>
(function(){
  if (window.__pcxInit) return; window.__pcxInit = true;

  var css = '.pcx-meta,.pcx-countdown,.pcx-actions{text-align:left;font-size:13px;line-height:1.3}'
  /* Hàng: ô đánh giá + đã bán */
  + '.pcx-meta{display:flex;align-items:center;gap:8px;margin:4px 0 6px;min-height:20px;color:#555}'
  + '.pcx-badge{display:inline-flex;align-items:center;gap:3px;height:20px;padding:0 6px;border:1px solid #f5b301;background:#fffaf0;border-radius:3px;font-size:12px;font-weight:600;line-height:1;color:#333}'
  + '.pcx-badge .pcx-star{color:#f5b301;font-size:12px}'
  + '.pcx-badge--none{border-color:#ddd;background:#f7f7f7;color:#999}'
  + '.pcx-badge--none .pcx-star{color:#ccc}'
  + '.pcx-sold{color:#555;font-size:12px}'
  + '.pcx-countdown{display:flex;gap:6px;margin:6px 0}'
  + '.pcx-countdown div{background:#2c3e50;color:#fff;border-radius:3px;width:44px;padding:4px 2px;text-align:center}'
  + '.pcx-countdown b{display:block;font-size:14px}.pcx-countdown span{font-size:10px;opacity:.85}'
  /* Form: ô số lượng + nút, xếp dọc và cùng full chiều ngang */
  + '.pcx-form{display:flex;flex-direction:column;gap:6px;margin:0}'
  + '.pcx-qty{flex:none;display:flex;width:100%;border:1px solid #ddd;border-radius:3px;overflow:hidden;height:34px}'
  + '.pcx-qty button{flex:0 0 40px;padding:0;background:#f7f7f7;border:0;cursor:pointer;font-size:16px;color:#666}'
  + '.pcx-qty input{flex:1 1 auto;min-width:0;width:100%;height:100%;padding:0;margin:0;text-align:center;border:0;border-left:1px solid #ddd;border-right:1px solid #ddd;border-radius:0;box-shadow:none;font-size:13px;-moz-appearance:textfield}'
  + '.pcx-qty input::-webkit-outer-spin-button,.pcx-qty input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}'
  + '.pcx-btn{flex:1 1 118px;min-width:118px;display:flex;align-items:center;justify-content:center;height:34px;padding:0 4px;background:#bf2026;color:#fff;border:0;border-radius:3px;font-size:12px;font-weight:700;line-height:1.15;text-align:center;white-space:nowrap;cursor:pointer;text-decoration:none}'
  + '.pcx-form .pcx-btn{flex:none;width:100%;min-width:0}'
  + '.pcx-btn:hover{background:#a01a20;color:#fff}'
  + '.pcx-btn--contact{background:#bf2026}.pcx-btn--contact:hover{background:#a01a20;color:#fff}';
  var st = document.createElement('style'); st.appendChild(document.createTextNode(css)); document.head.appendChild(st);

  document.addEventListener('click', function(e){
    var m = e.target.closest('[data-pcx-minus]'), p = e.target.closest('[data-pcx-plus]');
    if (!m && !p) return;
    var input = e.target.closest('.pcx-qty').querySelector('input');
    input.value = Math.max(1, (parseInt(input.value, 10) || 1) + (p ? 1 : -1));
  });

  function endTime(s){ if (s.indexOf('T') === -1) s += 'T23:59:59'; return new Date(s).getTime(); }
  function tick(){
    var now = Date.now();
    document.querySelectorAll('.pcx-countdown').forEach(function(el){
      var diff = Math.max(0, endTime(el.getAttribute('data-end')) - now);
      if (diff === 0) { el.style.display = 'none'; return; }
      el.querySelector('[data-d]').textContent = Math.floor(diff / 864e5);
      el.querySelector('[data-h]').textContent = Math.floor(diff % 864e5 / 36e5);
      el.querySelector('[data-m]').textContent = Math.floor(diff % 36e5 / 6e4);
    });
  }
  tick(); setInterval(tick, 30000);
})();
</script>
</body>
</html>
